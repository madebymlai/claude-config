#!/usr/bin/env python3
"""Search a repository's code and read it by definition.

  explore hits [RG_FLAGS] PATTERN [PATH...]   matches grouped under their enclosing definitions
  explore outline FILE...                     each file's definitions with their line ranges
  explore show FILE:LINE | FILE:START-END | FILE START [END] ...
                                              numbered windows (FILE:LINE gives LINE-10..LINE+20)

hits runs two rg searches at once: an ordinary rg walk that also searches
hidden files and skips only .git, and a search of the tracked files that
.gitignore hides from a plain rg, whose file lines are tagged
[tracked, hidden by .gitignore]. Binary files are skipped; submodules and
nested repositories are searched like any directory. A tracked file that a
submodule's own .gitignore hides is found only when hits runs inside that
submodule.

Each match is shown under its owner chain (impl Foo > fn new), with the
innermost definition's line range. Definitions come from ast-grep's parse of
the file; a file in a language ast-grep does not parse shows (no parser), a
file it returns no definitions for shows (no definitions found), a file
ast-grep skipped shows (ast-grep skipped: REASON), with ast-grep's reason,
such as permissionDenied, or no language when it finds none for the file, and
a file ast-grep failed on shows (ast-grep failed).

RG_FLAGS pass to rg, before or after PATTERN; after -- every token is PATTERN
or PATH. Examples: -i -w -F -P -U -L -t java -g '*.rs' -C 2, and -E latin1,
rg's --encoding, for text that is not UTF-8. -n and -N are accepted and
dropped. A flag hits cannot honour is refused: rg's printing options, such as
-o, -M, --column or --trim, and flags that print something other than a
search, such as --files or --type-list. With -e PATTERN or -f FILE, every
positional is a PATH. -w refuses a PATTERN whose first or last character is
a literal non-word character, such as the . and ( of a pattern for .due(,
which -w would match only beside another non-word character. -l and -c
print one line per file with its count of matching lines, --count-matches
with its count of matches. --max N (or --max=N) caps the matches printed
(default 300); over the cap, hits prints counts by directory and file
instead.

--json makes hits and outline print one JSON document, for a script to read;
show prints text only, for reading. Paths are as the text prints them, lines
1-based. A def is {start, end, sig, kind, name}: its line range, the line
holding its name, its ast-grep node kind (function_item, ...), and its name,
null when it has none (a Rust impl is named by its type). A skip is
{file, why, reason?}: a file that shows no definitions, with why one of
"no parser", "no definitions", "failed", "skipped" (reason: ast-grep's, or
"no language").
  hits:    {total, files, searched, cap, over, counts, rows, skips, hidden, errors}
           total and files as the header counts them; counts is {path: n} for
           every file when the text prints counts (-l, -c, --count-matches, or
           over the cap), else null. rows lists the matches when the text does,
           and is null when it prints counts instead: {file, line, text,
           owners: [def, outermost first], test, subs, hidden, ctx}, with text
           the whole line and ctx the -A/-B/-C lines grouped with it,
           [{line, text}]. test is a guess from names that the match is test
           code: a directory named test(s), testing, __tests__ or spec(s), a
           file named as tests are (test_*.py, *_test.go, *Test.java,
           *.spec.ts, ...), an owner that is a module named tests or test or a
           class named Test followed by a capital or _, *Test or *Tests, or a
           Rust file that its parent module declares under #[cfg(test)], as
           #[cfg(test)] mod x; does, or one under such a module. subs has one
           {col, end, in, def} per match on the line: col and end are 0-based
           character columns, the match being text[col:end] (under -U a match
           may run on into the lines below, its columns counting their
           newlines); in is where the match starts: "code", "comment" or
           "string", or null when ast-grep did not parse the file, or a warning
           says its lines are too long to place matches in; def is true when
           the match is the name of a definition this line holds. hidden lists
           the matched files tagged hidden, errors all of rg's errors.
  outline: {files: [{file, defs: [def + depth]}], skips, missing}
           missing lists the FILE arguments that are not files.
warnings (both) holds what text mode writes to stderr, so a --json run that
succeeds writes only the document and exits 0. An error exits nonzero with
its message on stderr and no document, as in text.
"""
import codecs
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from collections import Counter, OrderedDict, namedtuple

try:
    import msgspec
except ModuleNotFoundError:
    print("explore: needs the msgspec module: pacman -S python-msgspec, or pip install msgspec", file=sys.stderr)
    sys.exit(2)


# ---- the JSON rg and ast-grep print, decoded into only the fields explore reads ----------------

class Field(msgspec.Struct, gc=False):  # rg's text, or its bytes when they are not UTF-8
    text: str | None = None
    raw: bytes | None = msgspec.field(name="bytes", default=None)


class Submatch(msgspec.Struct, gc=False):
    start: int
    end: int


class Stats(msgspec.Struct, gc=False):
    matched_lines: int = 0
    matches: int = 0
    searches: int = 0


class Lines(msgspec.Struct, gc=False):
    path: Field
    lines: Field
    line_number: int | None
    submatches: list[Submatch]


class FileEnd(msgspec.Struct, gc=False):
    path: Field
    stats: Stats


class Totals(msgspec.Struct, gc=False):
    stats: Stats


class Match(msgspec.Struct, gc=False, tag_field="type", tag="match"):
    data: Lines


class Context(msgspec.Struct, gc=False, tag_field="type", tag="context"):
    data: Lines


class End(msgspec.Struct, gc=False, tag_field="type", tag="end"):
    data: FileEnd


class Summary(msgspec.Struct, gc=False, tag_field="type", tag="summary"):
    data: Totals


RG = msgspec.json.Decoder(Match | Context | End | Summary)  # the begin events are never decoded


class Position(msgspec.Struct, gc=False):
    line: int
    column: int = 0


class Offsets(msgspec.Struct, gc=False):
    start: int
    end: int


class Range(msgspec.Struct, gc=False):
    start: Position
    end: Position
    byteOffset: Offsets


class Capture(msgspec.Struct, gc=False):
    range: Range


class Captures(msgspec.Struct, gc=False):
    NAME: Capture | None = None
    TYPE: Capture | None = None


class MetaVariables(msgspec.Struct, gc=False):
    single: Captures


class SgMatch(msgspec.Struct, gc=False):
    file: str
    range: Range
    ruleId: str
    metaVariables: MetaVariables | None = None


SG = msgspec.json.Decoder(SgMatch)

# language: (file extensions, definition node kinds, arrow-function bindings count as definitions)
LANGUAGES = {
    "rust": (("rs",), ("function_item", "impl_item", "trait_item", "struct_item", "enum_item", "mod_item", "macro_definition", "union_item",), False),
    "java": (("java",), ("class_declaration", "interface_declaration", "enum_declaration", "record_declaration", "annotation_type_declaration", "method_declaration", "constructor_declaration",), False),
    "kotlin": (("kt", "kts",), ("class_declaration", "object_declaration", "function_declaration",), False),
    "python": (("py", "pyi",), ("function_definition", "class_definition",), False),
    "javascript": (("js", "mjs", "cjs", "jsx",), ("function_declaration", "generator_function_declaration", "class_declaration", "method_definition",), True),
    "typescript": (("ts", "mts", "cts",), ("function_declaration", "generator_function_declaration", "class_declaration", "abstract_class_declaration", "method_definition", "interface_declaration", "enum_declaration", "module", "internal_module",), True),
    "tsx": (("tsx",), ("function_declaration", "class_declaration", "abstract_class_declaration", "method_definition", "interface_declaration", "enum_declaration", "internal_module",), True),
    "go": (("go",), ("function_declaration", "method_declaration", "type_declaration",), False),
    "csharp": (("cs",), ("namespace_declaration", "class_declaration", "struct_declaration", "interface_declaration", "enum_declaration", "record_declaration", "method_declaration", "constructor_declaration",), False),
    "c": (("c", "h",), ("function_definition", "struct_specifier",), False),
    "cpp": (("cpp", "cc", "cxx", "hpp", "hh", "hxx",), ("function_definition", "class_specifier", "struct_specifier", "namespace_definition",), False),
    "ruby": (("rb",), ("class", "module", "method", "singleton_method",), False),
    "php": (("php",), ("class_declaration", "interface_declaration", "trait_declaration", "function_definition", "method_declaration",), False),
    "swift": (("swift",), ("class_declaration", "protocol_declaration", "function_declaration",), False),
    "scala": (("scala", "sc",), ("class_definition", "object_definition", "trait_definition", "function_definition",), False),
    "lua": (("lua",), ("function_declaration",), False),
    "bash": (("sh", "bash",), ("function_definition",), False),
}
LANGUAGE_OF = {ext: lang for lang, (exts, _, _) in LANGUAGES.items() for ext in exts}
# the child of a definition that holds its name: the name field, a C or C++ function's declarator, and in Kotlin,
# whose grammar names no fields, the identifier child. A rule naming a field its grammar lacks does not compile.
NAME_FIELD = ({"field": "name"},)
NAME_CHILD = {"c": NAME_FIELD + ({"field": "declarator"},), "cpp": NAME_FIELD + ({"field": "declarator"},),
              "kotlin": ({"any": [{"kind": "simple_identifier"}, {"kind": "type_identifier"}]},)}
# the child that names a definition without a name child, captured as $TYPE so that its signature stays its first
# line: a Rust impl's type
TYPE_CHILD = {"rust": {"field": "type"}}
ARROW = "variable_declarator"  # the kind of an arrow-function binding
Def = namedtuple("Def", "start end sig kind name")


def places(comment="", string="", code=""):
    """{node kind: place} for the kinds named in each, space-separated."""
    return {k: place for place, kinds in (("comment", comment), ("string", string), ("code", code)) for k in kinds.split()}


# language: the node kinds a match sits in when it is in a comment or a string; a match in none sits in code, and so
# does one in a kind that puts code back inside a string, such as an interpolation
PLACES = {
    "rust": places("line_comment block_comment", "string_literal raw_string_literal char_literal"),
    "java": places("line_comment block_comment", "string_literal character_literal", "string_interpolation"),
    "kotlin": places("line_comment multiline_comment", "string_literal character_literal",
                     "interpolated_expression interpolated_identifier"),
    "python": places("comment", "string", "interpolation"),
    "javascript": places("comment html_comment", "string template_string regex jsx_text", "template_substitution"),
    "typescript": places("comment", "string template_string regex", "template_substitution"),
    "tsx": places("comment", "string template_string regex jsx_text", "template_substitution"),
    "go": places("comment", "interpreted_string_literal raw_string_literal rune_literal"),
    "csharp": places("comment", "string_literal verbatim_string_literal raw_string_literal interpolated_string_expression "
                     "character_literal", "interpolation"),
    "c": places("comment", "string_literal char_literal system_lib_string"),
    "cpp": places("comment", "string_literal char_literal raw_string_literal system_lib_string"),
    "ruby": places("comment", "string heredoc_body regex character subshell delimited_symbol string_array", "interpolation"),
    "php": places("comment", "string encapsed_string heredoc nowdoc"),
    "swift": places("comment multiline_comment", "line_string_literal multi_line_string_literal raw_string_literal",
                    "interpolated_expression"),
    "scala": places("comment block_comment", "string interpolated_string interpolated_string_expression character_literal",
                    "interpolation"),
    "lua": places("comment", "string"),
    "bash": places("comment", "string raw_string ansi_c_string heredoc_body",
                   "command_substitution expansion simple_expansion"),
}
# ast-grep prints each node with its whole lines, so a file's comments and strings cost about the number on each line
# times its length; a file over this, such as a minified bundle, is parsed without them
PLACE_BUDGET = 64 << 20

SHORT_WITH_VALUE = set("ABCmMtTgefjdE")
LONG_WITH_VALUE = {"--type", "--type-not", "--type-add", "--type-clear", "--glob", "--iglob", "--after-context",
                   "--before-context", "--context", "--max-count", "--max-columns", "--max-depth", "--max-filesize",
                   "--encoding", "--engine", "--file", "--threads", "--dfa-size-limit", "--regex-size-limit",
                   "--path-separator", "--pre", "--pre-glob", "--context-separator", "--ignore-file", "--color",
                   "--colors", "--sort", "--sortr", "--hyperlink-format", "--field-context-separator",
                   "--field-match-separator"}
DROPPED = {"-n", "-N", "-R", "-H", "--with-filename", "--extended-regexp", "--line-number", "--no-line-number",
           "--recursive", "--color", "--colors", "--sort", "--sortr", "--sort-files", "--no-sort-files"}
DIGEST = {"-l", "-c", "--files-with-matches", "--count", "--count-matches"}
# rg's flags that hits cannot honour: those of its standard printer and their negations, which leave its JSON as it
# is, those that replace the search with other output, and those that only write to stderr
REFUSED = {"--files", "--files-without-match", "--vimgrep", "-q", "--quiet", "-r", "--replace", "--passthru", "--passthrough",
           "--stats", "--null", "-0", "--heading", "-p", "--pretty",
           "-b", "--byte-offset", "--no-byte-offset", "--column", "--no-column", "--context-separator",
           "--no-context-separator", "--field-context-separator", "--field-match-separator", "--hostname-bin",
           "--hyperlink-format", "--include-zero", "--no-include-zero", "-M", "--max-columns", "--max-columns-preview",
           "--no-max-columns-preview", "-o", "--only-matching", "--path-separator", "--trim", "--no-trim", "-I",
           "--no-filename", "--no-heading", "--no-stats", "--block-buffered", "--no-block-buffered", "--line-buffered",
           "--no-line-buffered",
           "-h", "--help", "-V", "--version", "--pcre2-version", "--type-list", "--generate", "--no-json",
           "--debug", "--trace"}
TAG = "  [tracked, hidden by .gitignore]"


def die(msg, code=2):
    print(f"explore: {msg}", file=sys.stderr)
    sys.exit(code)


def plural(n, word):
    return f"{n} {word}" + ("" if n == 1 else "es" if word == "match" else "s")


def decode(data):
    """DATA as UTF-8, or as Latin-1 when it is not UTF-8, which keeps every byte as one character."""
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        return data.decode("latin-1")


def read_lines(path, cache={}):
    if path not in cache:
        with open(path, "rb") as f:
            cache[path] = decode(f.read()).split("\n")
    return cache[path]


# ---- definitions, from ast-grep -------------------------------------------------------------

def language(path):
    return LANGUAGE_OF.get(os.path.splitext(path)[1].lstrip(".").lower())


def rules(lang):
    """ast-grep's rules for LANG's definitions, one per node kind, each with its id: def-LANG-KIND."""
    _, kinds, arrow = LANGUAGES[lang]
    matchers = [(k, {"kind": k}) for k in kinds]
    if arrow:
        matchers.append((ARROW, {"all": [{"kind": ARROW}, {"has": {"kind": "arrow_function"}}]}))
    for k, kind in matchers:
        # $NAME captures the name child; a definition without one, such as a Rust impl, matches by its kind alone
        named = [{"all": [kind, {"has": {**child, "pattern": "$NAME"}}]} for child in NAME_CHILD.get(lang, NAME_FIELD)]
        if lang in TYPE_CHILD:
            named.append({"all": [kind, {"has": {**TYPE_CHILD[lang], "pattern": "$TYPE"}}]})
        yield json.dumps({"id": f"def-{lang}-{k}", "language": lang, "rule": {"any": named + [kind]}})


def place_rules(lang):
    """ast-grep's rules for LANG's comments and strings, each with its id: in-LANG-KIND."""
    for k in PLACES[lang]:
        yield json.dumps({"id": f"in-{lang}-{k}", "language": lang, "rule": {"kind": k}})


def place_cost(data):
    """About how many bytes ast-grep prints for DATA's comments and strings, at most: each line's length times its
    delimiters, a line up to 128 characters counted as 128 long, so only the longer lines are visited."""
    delimiters = lambda b: (b.count(b'"') + b.count(b"'") + b.count(b"`")) // 2 + b.count(b"//") + b.count(b"/*") \
        + b.count(b"#") + b.count(b"--")
    long = [l for l in data.split(b"\n") if len(l) > 128]
    in_long = [delimiters(l) for l in long]
    return sum(len(l) * n for l, n in zip(long, in_long)) + 128 * max(0, delimiters(data) - sum(in_long))


def name_of(lang, path, var):
    """The name a definition's $NAME or $TYPE capture VAR holds, read from PATH by VAR's range, whose columns count
    characters, so that a copy ast-grep parsed in its place gives the original's text; a C or C++ function's
    declarator, such as *Foo::bar(int x), names it by what precedes its parameters."""
    lines, start, end = read_lines(path), var.range.start, var.range.end
    if start.line == end.line:
        text = lines[start.line][start.column:end.column]
    else:
        text = "\n".join([lines[start.line][start.column:], *lines[start.line + 1:end.line], lines[end.line][:end.column]])
    if lang in ("c", "cpp"):
        return " ".join(text.split("(")[0].split()).strip("*& ")
    return text


def sg_source(f, data, n, tmp):
    """The file ast-grep is to parse for F, whose bytes are DATA: F itself, or a UTF-8 copy with the same lines, in
    TMP and numbered N. ast-grep skips a file that is not UTF-8 and panics on a name that is not, and drops a
    definition that an ast-grep-ignore comment suppresses, even under --inline-rules, so such a file is parsed from a
    copy whose comments read ast-grep-IGNORE, which ast-grep does not honour."""
    try:
        data.decode("utf-8")
        os.fsencode(f).decode("utf-8")
        if b"ast-grep-ignore" not in data:
            return f
    except UnicodeDecodeError:
        pass
    copy = os.path.join(tmp, f"{n}{os.path.splitext(f)[1]}")
    with open(copy, "w", encoding="utf-8") as out:
        out.write(decode(data).replace("ast-grep-ignore", "ast-grep-IGNORE"))
    return copy


def sg_entities(stderr):
    """{path: what ast-grep says of the file} from the lines of its STDERR under --inspect entity, which writes
    "sg: entity|file|PATH: language=Rust,..." for each file ast-grep parses and "sg: entity|file|PATH: skipped=REASON"
    for each it skips; it writes neither for a file it finds no language for, such as one whose extension is in
    capitals."""
    entity = {}
    for line in stderr:
        if line.startswith("sg: entity|file|"):
            path, _, info = line[len("sg: entity|file|"):].rpartition(": ")
            entity[os.path.normpath(path)] = info
    return entity


def sg_skip(info, failed, found):
    """Why ast-grep gave a file no definitions, from what --inspect entity said of it, INFO (see sg_entities), whether
    its run FAILED and whether it FOUND definitions in the file: "ast-grep skipped: REASON", "ast-grep failed" or
    "ast-grep skipped: no language"; None when it parsed the file."""
    if info is not None and info.startswith("skipped="):
        return "ast-grep skipped: " + info[len("skipped="):]
    if failed and not found:
        return "ast-grep failed"
    if info is None:
        return "ast-grep skipped: no language"
    return None


def definitions(files, placed=False):
    """({path: [Def]} for every file ast-grep parses, and for a file it did not parse the reason, such as
    "ast-grep failed" or "ast-grep skipped: fileTooLarge"; 1-based inclusive lines. The signature is the line holding
    the definition's name, which follows its annotations; the kind is its node kind, and the name is None for a
    definition with neither a name child nor a type child. Then whether ast-grep is missing, and with PLACED the
    comments and strings of each file it parsed with them, {path: {line: [(start line, start column, end line,
    end column, place)]}}, 0-based, columns in characters, each node listed under every line it spans.)"""
    parsed = [f for f in files if language(f)]
    defs, where = {f: [] for f in parsed}, {}
    if not parsed or not shutil.which("ast-grep"):
        return defs, bool(parsed), where
    langs = sorted({language(f) for f in parsed})
    plain = "\n---\n".join(r for l in langs for r in rules(l))
    joined = "\n---\n".join([plain, *(r for l in langs for r in place_rules(l))]) if placed else plain
    with tempfile.TemporaryDirectory() as tmp:
        source, costly = {}, set()
        for n, f in enumerate(parsed):
            try:
                with open(f, "rb") as fh:
                    data = fh.read()
            except OSError:  # ast-grep cannot read it either, and reports why
                source[os.path.normpath(f)] = f
                continue
            if placed and place_cost(data) > PLACE_BUDGET:
                costly.add(os.path.normpath(f))
                warn(f"{f}: lines too long to place its matches in code, comments or strings; its subs show in: null")
            source[os.path.normpath(sg_source(f, data, n, tmp))] = f
        cheap = [f for f in source if os.path.normpath(source[f]) not in costly]
        batches = [(cheap[i:i + 1000], placed) for i in range(0, len(cheap), 1000)]
        batches += [([f for f in source if os.path.normpath(source[f]) in costly], False)] if costly else []
        for batch, with_places in batches:
            r = subprocess.run(["ast-grep", "scan", "--inline-rules", joined if with_places else plain, "--json=stream",
                                "--inspect", "entity", "--", *batch], capture_output=True)
            for f in batch if with_places else ():
                where[os.path.normpath(source[f])] = {}
            originals, place_of = {}, {}  # each file ast-grep names, and each place rule's place
            for m in SG.decode_lines(r.stdout):
                path = originals.get(m.file)
                if path is None:
                    path = originals[m.file] = os.path.normpath(source.get(os.path.normpath(m.file), m.file))
                rng = m.range
                if m.ruleId.startswith("in-"):
                    where_in = place_of.get(m.ruleId)
                    if where_in is None:
                        lang, kind = m.ruleId[len("in-"):].split("-", 1)
                        where_in = place_of[m.ruleId] = PLACES[lang][kind]
                    node = (rng.start.line, rng.start.column, rng.end.line, rng.end.column, where_in)
                    for line in range(rng.start.line, rng.end.line + 1):
                        where[path].setdefault(line, []).append(node)
                    continue
                single = m.metaVariables.single if m.metaVariables else Captures()
                start, end = rng.start.line + 1, rng.end.line + 1
                name, other = single.NAME, single.TYPE
                label = name.range.start.line + 1 if name else start
                lang, kind = m.ruleId[len("def-"):].split("-", 1)
                d = Def(start, end, read_lines(path)[label - 1].strip(), kind,
                        name_of(lang, path, name or other) if name or other else None)
                # the rules report one kind after another; a file's definitions sort into the order of its tree
                defs.setdefault(path, []).append((start, -end, rng.byteOffset.start, -rng.byteOffset.end, d))
            stderr = r.stderr.decode(errors="replace").splitlines()
            entity = sg_entities(stderr)
            if r.returncode != 0:
                why = next((l for l in stderr if l.strip() and not l.startswith("sg: ")), "")
                warn(f"ast-grep exited with {r.returncode}: {why}")
            for f in batch:
                path = os.path.normpath(source[f])
                why = sg_skip(entity.get(f), r.returncode != 0, defs[path])
                if why:
                    defs[path] = why
    for f in defs:
        if isinstance(defs[f], list):
            defs[f] = [d[-1] for d in sorted(defs[f], key=lambda d: d[:4])]
    return defs, False, {f: w for f, w in where.items() if isinstance(defs.get(f), list)}


def owner_chain(defs, line):
    """The definitions whose range holds LINE, outermost first; a definition starting on LINE is the match itself."""
    return [d for d in defs if d[0] < line <= d[1]]


def heading(path, line, defs):
    if path not in defs:
        return "(no parser)"
    if isinstance(defs[path], str):
        return f"({defs[path]})"
    if not defs[path]:
        return "(no definitions found)"
    chain = owner_chain(defs[path], line)
    if not chain:
        return "(top level)"
    short = lambda s: (s.rstrip("{ ").strip()[:87] + "...") if len(s.rstrip("{ ").strip()) > 90 else s.rstrip("{ ").strip()
    return f"{chain[-1].start}-{chain[-1].end} " + " > ".join(short(d.sig) for d in chain)


# ---- searching, with rg ---------------------------------------------------------------------

def parse_hits_args(argv):
    """(cap, rg flags, patterns, paths, digest, as_json), where digest is the field of rg's end stats that -l, -c or
    --count-matches prints per file, or None without them."""
    cap, flags, positional, patterns, it, literal, from_file, as_json = 300, [], [], [], iter(argv), False, False, False
    befores, prev = [], None  # for each positional, the long flag given without a value right before it, or None
    try:
        for tok in it:
            name, eq, value = tok.partition("=")
            bare, prev = prev, None
            if literal or not tok.startswith("-") or tok == "-":
                positional.append(tok)
                befores.append(bare)
            elif tok == "--":
                literal = True
            elif tok == "--json":
                as_json = True
            elif name == "--max":
                value = value if eq else next(it)
                if not value.isdigit():
                    die("--max takes a number")
                cap = int(value)
            elif name == "--regexp":
                patterns.append(value if eq else next(it))
            elif name == "--file":
                flags += ["--file", value if eq else next(it)]
                from_file = True
            elif name in REFUSED:
                die(f"{name} is not supported by hits; run rg directly for it")
            elif tok.startswith("--"):
                value = [next(it)] if name in LONG_WITH_VALUE and not eq else []
                if name not in DROPPED:
                    flags += [tok] + value
                prev = None if eq or value else tok
            else:
                for i, ch in enumerate(tok[1:]):  # a cluster such as -inw, whose last flag may take a value: -A2, -ie PAT
                    if "-" + ch in REFUSED:
                        die(f"-{ch} is not supported by hits; run rg directly for it")
                    if "-" + ch in DROPPED:
                        continue
                    if ch in SHORT_WITH_VALUE:
                        value = tok[i + 2:] or next(it)
                        if ch == "e":
                            patterns.append(value)
                        else:
                            flags += ["-" + ch, value]
                            from_file |= ch == "f"
                        break
                    flags.append("-" + ch)
    except StopIteration:
        die("a flag is missing its value")
    # as in rg: with no -e or -f the first positional is the pattern, with either every positional is a path
    by_flag = bool(patterns) or from_file
    if not by_flag:
        if not positional:
            die("usage: explore hits [RG_FLAGS] PATTERN [PATH...]   (a PATTERN starting with '-' goes after -e)")
        patterns, positional, befores = positional[:1], positional[1:], befores[1:]
    paths = positional
    for p, bare in zip(paths, befores):
        if not os.path.exists(p):
            die(no_such_path(p, bare, by_flag))
    if any(f in ("-w", "--word-regexp") for f in flags):
        fixed = any(f in ("-F", "--fixed-strings") for f in flags)
        for p in patterns:
            edge = loose_edge(p, fixed)
            if edge:
                die(f"-w adds word boundaries outside the pattern, so '{p}', which {edge[0]} with '{edge[1]}', matches "
                    "only beside a non-word character; drop -w and put \\b on the word's own edges")
    digest = ("matches" if "--count-matches" in flags else "matched_lines") if any(f in DIGEST for f in flags) else None
    return cap, [f for f in flags if f not in DIGEST], patterns, paths, digest, as_json


def no_such_path(path, bare, by_flag):
    """The error for a PATH that does not exist, saying why it was read as a path when the arguments show why: it
    follows BARE, a long flag given without a value, or the patterns came from -e or -f (BY_FLAG), or else it follows
    the pattern, where a second pattern lands."""
    if bare:
        return f"no such path: {path}, read as a path after {bare}; give a flag's value as {bare}=VALUE (hits caps its rows with --max N)"
    if by_flag:
        return f"no such path: {path}; with -e or -f every positional is a path, so give each pattern its own -e"
    return f"no such path: {path}; every argument after PATTERN is a path, so a second pattern needs -e, as in -e PAT1 -e PAT2"


def loose_edge(pattern, fixed):
    """("starts", c) or ("ends", c) when PATTERN's first or last character is a literal c that is not a word character,
    beside which -w finds a match only when a non-word character follows or precedes; None when neither edge is such
    a literal. A regex edge that is a class, a group, an escape such as \\b or a repetition is not a literal."""
    p = pattern
    if not fixed:
        p = p[1:] if p.startswith("^") else p
        p = p[:-1] if p.endswith("$") and not p.endswith("\\$") else p
    if not p:
        return None
    loose = lambda c: c.isascii() and not (c.isalnum() or c == "_")
    if fixed:
        first, last = p[0], p[-1]
    else:
        first = (p[1] if len(p) > 1 and not p[1].isalnum() else None) if p[0] == "\\" else (None if p[0] in "([." else p[0])
        if len(p) > 1 and p[-2] == "\\":
            last = None if p[-1].isalnum() else p[-1]
        else:
            last = None if p[-1] in ")]*+?}." else p[-1]
    if first is not None and loose(first):
        return ("starts", first)
    if last is not None and loose(last):
        return ("ends", last)
    return None


def git_top():
    r = subprocess.run(["git", "rev-parse", "--show-toplevel"], stdin=subprocess.DEVNULL, capture_output=True, text=True)
    return os.path.realpath(r.stdout.strip()) if r.returncode == 0 else None


def hidden_tracked(paths, top):
    """The tracked files that .gitignore hides under PATHS, or under the working directory without PATHS; a PATH
    outside the repository at TOP holds none."""
    real = [os.path.realpath(p) for p in paths]
    inside = [r for r in real if (r + os.sep).startswith(top + os.sep)]
    if paths and not inside:
        return set()
    # each pathspec is relative to TOP, through any symlink, and literal, so a name holding * or [ matches only itself;
    # TOP itself is the empty path, since a literal . matches no file
    scope = inside or [os.getcwd()]  # without PATHS, the working directory
    specs = [":(top,literal)" + (os.path.relpath(r, top) if r != top else "") for r in scope]
    # hidden = tracked minus walked: the files the search's own walk skips, found without matching any ignore rule,
    # which git ls-files -ci would do against every entry of the index; the walk runs while git lists the index
    # both lists run from TOP and are compared as raw bytes, relative to TOP; only the files left over are converted
    # to paths from the working directory
    from_top = [os.path.relpath(r, top) for r in scope]
    walk = subprocess.Popen(["rg", "--files", "--null", "--hidden", "--no-ignore-dot", "-g", "!.git", "--", *from_top],
                            cwd=top, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    done = subprocess.run(["git", "ls-files", "-z", "--full-name", "--", *specs], cwd=top, stdin=subprocess.DEVNULL,
                          capture_output=True)
    walked, walk_err = walk.communicate()
    if done.returncode != 0:
        # without this list the tracked files .gitignore hides would drop out of the result unannounced
        err = os.fsdecode(done.stderr).strip().splitlines()
        die(f"git ls-files exited with {done.returncode}: {err[0] if err else 'no message'}")
    if walk.returncode == 2 and not walked:
        err = os.fsdecode(walk_err).strip().splitlines()
        die(f"rg --files exited with 2: {err[0] if err else 'no message'}")
    seen = {n[2:] if n.startswith(b"./") else n for n in walked.split(b"\0")}
    skipped = (os.path.join(top, os.fsdecode(n)) for n in done.stdout.split(b"\0") if n and n not in seen)
    # a submodule is a directory in the index and a symlink is not walked: neither is a file the walk skipped
    return {os.path.relpath(f) for f in skipped if os.path.isfile(f) and not os.path.islink(f)}


def roots(files):
    """The directories that directly hold FILES."""
    return sorted({os.path.dirname(f) or "." for f in files})


def rg_json(args):
    """rg run with ARGS, its JSON output on a pipe to read as it runs and its stderr in a temporary file, which no
    full pipe can stall."""
    err = tempfile.TemporaryFile()
    return subprocess.Popen(["rg", "--json", "--no-config", *args], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=err), err


def text_of(field, offsets=()):
    """The text of an rg JSON field, and the character column of each byte offset in OFFSETS, ascending."""
    raw = field.text.encode() if field.text is not None else field.raw
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        return raw.decode("latin-1"), list(offsets)
    # one pass over the bytes: the decoder holds back a character an offset splits, as decoding up to it would drop it
    decoder, columns, n, last = codecs.getincrementaldecoder("utf-8")(errors="ignore"), [], 0, 0
    for offset in offsets:
        n += len(decoder.decode(raw[last:offset]))
        columns.append(n)
        last = offset
    return text, columns


def submatches(text, columns):
    """The (column, end, lines below the first, column in its line) of each submatch, from the character columns of
    its start and end in TEXT, which spans several lines in a multiline search."""
    out = []
    for col, end in zip(columns[::2], columns[1::2]):
        below = text.count("\n", 0, col)
        out.append((col, end, below, col - text.rfind("\n", 0, col) - 1 if below else col))
    return tuple(out)


def path_of(field):
    """An rg JSON path, relative to the working directory however it was given."""
    path = field.text if field.text is not None else os.fsdecode(field.raw)
    return os.path.normpath(os.path.relpath(path) if os.path.isabs(path) else path)


def events(stdout, keep, cap, count, per_file, rows):
    """Read rg's JSON output from the pipe STDOUT as it arrives into PER_FILE, {path: COUNT field of its end stats},
    and ROWS, a set of (path, line, text, is_match, submatches), decoding match and context rows only until ROWS holds
    more than CAP matches, so that memory follows what is kept rather than what rg prints. KEEP, when given, limits
    both to its paths. Returns the number of files searched."""
    searched, matches = 0, sum(r[3] for r in rows)
    for raw in stdout:
        if raw.startswith(b'{"type":"end"'):
            d = RG.decode(raw).data
            path = path_of(d.path)
            n = getattr(d.stats, count)
            if (keep is None or path in keep) and n:
                per_file[path] = n
        elif raw.endswith(b'"type":"summary"}\n'):
            searched += RG.decode(raw).data.stats.searches
        elif matches <= cap and (raw.startswith(b'{"type":"match"') or raw.startswith(b'{"type":"context"')):
            ev = RG.decode(raw)
            d, is_match = ev.data, isinstance(ev, Match)
            path = path_of(d.path)
            if keep is None or path in keep:
                # rg lists a line's submatches in order, so their offsets ascend
                text, columns = text_of(d.lines, [o for m in d.submatches for o in (m.start, m.end)] if is_match else ())
                row = (path, d.line_number, text.rstrip("\n").split("\n")[0], is_match, submatches(text, columns))
                matches += is_match and row not in rows
                rows.add(row)
    return searched


def search(flags, patterns, paths, cap, count):
    """({path: count}, rows, files searched, rg errors, tracked files .gitignore hides); see events."""
    top = git_top()
    regexps = [a for p in patterns for a in ("-e", p)]
    walk = ["--hidden", "--no-ignore-dot", "-g", "!.git", *flags, *regexps, "--", *paths]
    runs = [rg_json(walk)]
    hidden = hidden_tracked(paths, top) if top else set()
    if hidden:
        # it runs alongside the first, and its output waits on its pipe until the first's is read
        runs.append(rg_json(["--no-ignore", "--hidden", *flags, "--max-depth", "1", *regexps, "--", *roots(hidden)]))
    per_file, rows, searched, errors = {}, set(), 0, []
    for k, (rg, err) in enumerate(runs):
        with rg, err:
            s = events(rg.stdout, hidden if k == 1 else None, cap, count, per_file, rows)
            searched += s if k == 0 else 0
            if rg.wait() == 2:
                err.seek(0)
                errors += [e for e in err.read().decode(errors="replace").splitlines() if e.strip()]
    return dict(sorted(per_file.items())), sorted(rows, key=lambda r: (r[0], r[1])), searched, errors, hidden


def hits(argv):
    cap, flags, patterns, paths, digest, as_json = parse_hits_args(argv)
    collect_warnings(as_json)
    per_file, rows, searched, errors, hidden = search(flags, patterns, paths, -1 if digest else cap,
                                                       digest or "matched_lines")
    total = sum(per_file.values())
    tag = lambda p: TAG if p in hidden else ""
    if not total:
        if errors:
            die("\n".join(errors[:5]))
        if searched == 0 and not hidden:
            die("searched 0 files; check the PATH arguments and the working directory")
    listed = total and not digest and total <= cap
    defs, anchors, where = owners(rows, as_json) if listed else ({}, [], {})
    if as_json:
        files = sorted({r[0] for r in rows if r[3]})
        print_json({"total": sum(r[3] for r in rows) if listed else total, "files": len(files) if listed else len(per_file),
                    "searched": searched, "cap": cap, "over": not digest and total > cap,
                    "counts": per_file if total and not listed else None,
                    "rows": match_rows(rows, anchors, defs, where, hidden) if listed else None if total else [],
                    "skips": skips(files, defs) if listed else [],
                    "hidden": [p for p in per_file if p in hidden], "errors": errors, "warnings": WARNINGS})
        return
    if not total:
        print(f"0 matches in {plural(searched, 'file')} searched")
        return
    if digest:
        for path in sorted(per_file):
            print(f"{per_file[path]:>6}  {path}{tag(path)}")
    elif total > cap:
        print(f"{plural(total, 'match')} in {plural(len(per_file), 'file')}, over the cap of {cap}: "
              "counts below. Narrow with PATH, -t or -g, or raise --max.")
        per_dir = Counter()
        for path, n in per_file.items():
            per_dir[os.path.dirname(path) or "."] += n
        print("by directory:")
        for d, n in per_dir.most_common(20):
            print(f"  {n:>6}  {d}/")
        print("by file:")
        for p, n in Counter(per_file).most_common(20):
            print(f"  {n:>6}  {p}{tag(p)}")
    else:
        print_grouped(rows, defs, anchors, tag)
    if errors:
        print(f"rg reported {plural(len(errors), 'error')}; the results above cover the other files:")
        for e in errors[:5]:
            print("  " + e)


def clip(text, column, width=160):
    """WIDTH characters of TEXT around COLUMN, with ... where the line is cut."""
    if len(text) <= width:
        return text
    start = max(0, min(column - width // 4, len(text) - width))
    return ("..." if start else "") + text[start:start + width] + ("..." if start + width < len(text) else "")


def owners(rows, placed=False):
    """The definitions of the files ROWS holds matches in, as definitions gives them, for each row the line of the
    match it belongs to: a match's own line, and a context line's nearest match in its file, the later on a tie; and
    with PLACED the files' comments and strings, as definitions gives them."""
    matches = [r for r in rows if r[3]]
    defs, no_parser, where = definitions(sorted({r[0] for r in matches}), placed)
    if no_parser:
        warn("ast-grep is not installed, so matches show no enclosing definition")
    match_lines = {}
    for p, n, _, _, _ in matches:
        match_lines.setdefault(p, []).append(n)
    return defs, [num if is_match else min(match_lines[path], key=lambda m: (abs(m - num), m < num))
                  for path, num, _, is_match, _ in rows], where


def place(nodes, line, col):
    """Where a character at 0-based LINE and COL sits among a file's comments and strings NODES on that line: in the
    innermost that holds it, the one starting last, else in code."""
    held = [n for n in nodes if (n[0], n[1]) <= (line, col) < (n[2], n[3])]
    return max(held, key=lambda n: (n[0], n[1], -n[2], -n[3]))[4] if held else "code"


TEST_DIRS = {"test", "tests", "testing", "__tests__", "spec", "specs"}
TEST_FILE = re.compile(r"^(?:tests?\.rs|testing\.rs|test_.*\.py|conftest\.py|.*_test\.(?:go|py|rs|rb|ex|exs)"
                       r"|.*(?:Tests?|IT)\.(?:java|kt|scala)|.*\.(?:test|spec)\.[jt]sx?|.*_spec\.rb)$")


def is_test(path, chain):
    """Whether a match in PATH, inside the definitions CHAIN, looks like test code: a directory or file named as tests
    are, a module named tests or test, a class named Test followed by a capital or _, *Test or *Tests, or a Rust file
    that a #[cfg(test)] declares as a module, or one under such a module. A guess from names and declarations."""
    *dirs, base = path.split(os.sep)
    if TEST_DIRS & set(dirs) or TEST_FILE.match(base):
        return True
    return any(d.kind == "mod_item" and d.name in ("tests", "test")
               or "class" in d.kind and d.name and re.match(r"Test[A-Z_]|.*Tests?$", d.name) for d in chain) \
        or test_module(path)


def test_module(path, cache={}):
    """Whether PATH is a Rust file that its parent module's file declares under #[cfg(test)], as #[cfg(test)] mod x;
    does, or whose parent module is such a file."""
    if path not in cache:
        cache[path] = False
        d, base = os.path.split(path)
        name = base[:-len(".rs")] if base.endswith(".rs") and base not in ("lib.rs", "main.rs") else ""
        if name == "mod":
            d, name = os.path.split(d)
        if name:
            for parent in [os.path.join(d, f) for f in ("mod.rs", "lib.rs", "main.rs")] + ([d + ".rs"] if d else []):
                try:
                    text = "\n".join(read_lines(parent))
                except OSError:
                    continue
                n = re.escape(name)
                if re.search(r"#\[cfg\(test\)\]\s*(?:#\[[^\]]*\]\s*)*(?:pub(?:\([^)]*\))?\s+)?mod\s+" + n + r"\s*;", text):
                    cache[path] = True
                    break
                if re.search(r"(?<!\w)mod\s+" + n + r"\s*;", text):
                    cache[path] = test_module(parent)
                    break
    return cache[path]


def is_def(defs, num, text, col, end):
    """Whether the match at COL to END on line NUM, whose text is TEXT, is the name of a definition in DEFS that the
    line holds."""
    return any(d.start <= num <= d.end and d.sig == text.strip() and d.name == text[col:end] for d in defs)


def match_rows(rows, anchors, defs, where, hidden):
    """The JSON row of each match in ROWS, with its owner chain, whether it looks like test code, its submatches placed
    by WHERE and marked when they name a definition, and the context lines that belong to it."""
    out = {}
    for path, num, text, is_match, subs in rows:
        if is_match:
            own = defs[path] if isinstance(defs.get(path), list) else []
            chain = owner_chain(own, num)
            nodes = where.get(path)
            out[path, num] = {"file": path, "line": num, "text": text, "owners": [d._asdict() for d in chain],
                              "test": is_test(path, chain),
                              "subs": [{"col": col, "end": end,
                                        "in": None if nodes is None else place(nodes.get(num - 1 + below, ()), num - 1 + below, at),
                                        "def": not below and is_def(own, num, text, col, end)}
                                       for col, end, below, at in subs],
                              "hidden": path in hidden, "ctx": []}
    for (path, num, text, is_match, _), anchor in zip(rows, anchors):
        if not is_match:
            out[path, anchor]["ctx"].append({"line": num, "text": text})
    return list(out.values())


def skips(files, defs):
    """The JSON entry of each of FILES that shows no definitions, with why, as its heading in the text says."""
    out = []
    for f in files:
        d = defs.get(f)
        if isinstance(d, list) and d:
            continue
        if d is None:
            out.append({"file": f, "why": "no parser"})
        elif not d:
            out.append({"file": f, "why": "no definitions"})
        elif d.startswith("ast-grep skipped: "):
            out.append({"file": f, "why": "skipped", "reason": d[len("ast-grep skipped: "):]})
        else:
            out.append({"file": f, "why": d[len("ast-grep "):]})
    return out


def print_grouped(rows, defs, anchors, tag):
    matches = [r for r in rows if r[3]]
    files = sorted({r[0] for r in matches})
    heads = {(p, n): heading(p, n, defs) for p, n, _, _, _ in matches}
    tree = OrderedDict()
    for (path, num, text, is_match, subs), anchor in zip(rows, anchors):
        column = subs[0][0] if subs else 0
        tree.setdefault(path, OrderedDict()).setdefault(heads[(path, anchor)], []).append((num, text, is_match, column))
    # with context lines a group keeps its relative indentation, so a line shows which block it sits in
    context = len(matches) < len(rows)
    print(f"{plural(len(matches), 'match')} in {plural(len(files), 'file')}")
    for path, groups in tree.items():
        print(path + tag(path))
        for head, ms in groups.items():
            print(f"  {head}")
            if context:
                indent = len(os.path.commonprefix([t[:len(t) - len(t.lstrip())] for _, t, _, _ in ms if t.strip()]))
            for num, text, is_match, column in ms:
                cut = indent if context else len(text) - len(text.lstrip())
                print(f"  {num:>6}{':' if is_match else '-'}   {clip(text.rstrip()[cut:], column - cut)}")


# ---- reading ---------------------------------------------------------------------------------

def nested(defs):
    """DEFS, a file's definitions in order, each with the depth it is nested at."""
    stack = []
    for d in defs:
        while stack and stack[-1] < d.start:
            stack.pop()
        yield len(stack), d
        stack.append(d.end)


def outline(argv):
    as_json, files = "--json" in argv, [a for a in argv if a != "--json"]
    collect_warnings(as_json)
    missing = [f for f in files if not os.path.isfile(f)]
    if not as_json:
        for f in missing:
            print(f"{f}: no such file")
    present = [os.path.normpath(f) for f in files if os.path.isfile(f)]
    defs, no_parser, _ = definitions(present)
    if no_parser:
        die("outline needs ast-grep, which is not installed")
    if as_json:
        print_json({"files": [{"file": path, "defs": [{**d._asdict(), "depth": depth} for depth, d in
                                                      nested(defs[path] if isinstance(defs.get(path), list) else [])]}
                              for path in present], "skips": skips(present, defs), "missing": missing,
                    "warnings": WARNINGS})
        return
    for path in present:
        if path not in defs:
            print(f"{path}: (no parser)")
            continue
        if isinstance(defs[path], str):
            print(f"{path}: ({defs[path]})")
            continue
        if not defs[path]:
            print(f"{path}: (no definitions found)")
            continue
        print(path)
        for depth, d in nested(defs[path]):
            print(f"  {'  ' * depth}{d.start}-{d.end}  {d.sig[:150]}")
    if missing:
        sys.exit(1)


def show(argv):
    if "--json" in argv:
        die("show prints text only; --json is for hits and outline")
    windows, rest = [], list(argv)
    while rest:
        if len(rest) >= 2 and ":" not in rest[0] and rest[1].isdigit():  # FILE START [END]
            start, has_end = int(rest[1]), len(rest) > 2 and rest[2].isdigit()
            windows.append((rest[0], start, int(rest[2]) if has_end else start + 59))
            rest = rest[3 if has_end else 2:]
            continue
        spec = rest.pop(0)
        m = re.match(r"^(.*?):(\d+)(?:([-,:])(\d+))?$", spec)
        if not m:
            die(f"show takes FILE:LINE, FILE:START-END or FILE START [END], not {spec!r}")
        path, line, sep, b = m.group(1), int(m.group(2)), m.group(3), m.group(4)
        if b and (sep != ":" or int(b) >= line):
            windows.append((path, line, int(b)))
        else:  # FILE:LINE, or FILE:LINE:COL as compilers print it
            windows.append((path, max(1, line - 10), line + 20))
    if not windows:
        die("show takes FILE:LINE, FILE:START-END or FILE START [END]")
    failed = 0
    for path, start, end in windows:
        try:
            lines = read_lines(path)
        except OSError as e:
            print(f"{path}: {e.strerror}")
            failed += 1
            continue
        count = len(lines) - (lines[-1] == "")  # a final newline ends the last line rather than starting one
        if max(start, 1) > min(end, count):
            print(f"{path} has {plural(count, 'line')}")
            continue
        if len(windows) > 1:
            print(f"== {path}:{start}-{end}")
        for n in range(max(start, 1), min(end, count) + 1):
            print(f"{n:>6}  {lines[n - 1]}")
    if failed:
        sys.exit(1)


SURROGATE = re.compile("[\ud800-\udfff]")


WARNINGS = None  # a list while --json collects the warnings into its document


def collect_warnings(as_json):
    global WARNINGS
    WARNINGS = [] if as_json else None


def warn(msg):
    """MSG on stderr, or into the --json document's warnings."""
    if WARNINGS is None:
        print(f"explore: {msg}", file=sys.stderr)
    else:
        WARNINGS.append(msg)


def print_json(doc):
    """DOC as one JSON document on stdout. A path that is not UTF-8 holds its undecodable bytes as the text output
    prints them, as the characters \\udcXX, so the document stays valid Unicode."""
    out = json.dumps(doc, separators=(",", ":"), ensure_ascii=False)
    sys.stdout.write(SURROGATE.sub(lambda m: f"\\\\u{ord(m[0]):04x}", out) + "\n")


def main():
    sys.stdout.reconfigure(errors="backslashreplace")
    args = sys.argv[1:]
    # -h or --help anywhere before a -- asks for this help, whichever command it follows
    if not args or {"-h", "--help"} & set(args[:args.index("--")] if "--" in args else args):
        print(__doc__.strip())
        return
    commands = {"hits": hits, "outline": outline, "show": show}
    if sys.argv[1] not in commands:
        die(f"unknown command {sys.argv[1]!r}; see explore --help")
    commands[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    main()
