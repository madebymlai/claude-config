#!/usr/bin/env python3
"""xp: prototype of question-shaped exploration commands over a cached definition index.

  trace index                         build or refresh the index, print timings
  trace callers TARGET [--depth N]    who reaches TARGET (Class.method, Type::method, name), receivers resolved,
                                   non-call links followed (new, reflect, config key, external-trait callback)
  trace flow TARGET [--depth N]       what TARGET does: its body reduced to in-repo calls and hand-off lines
  trace refs PATTERN                  rg matches as a budgeted digest (tests, comments, imports collapsed)
Common: --budget CHARS (default 6000), --tests (include test code)

callers --json prints the whole climb as one JSON document, never cut by --budget, paths relative to the repository:
  {target: {name, file, line}, edges: [{depth, kind, file, line, fn, into, test, text, tag}],
   set_aside: [{depth, into, counts}], entries: [{depth, kind, into, text}], skipped: [{file, reason}]}
An edge is a site reaching the definition into ({name, file, line}) from inside fn, depth hops from the target. kind
is call, call? (a receiver not resolved, or a type name with several definitions not proven to be the calling file's
own), new (the type constructed), reflect, reflect-cast, config, reads (a config key), or spawn (a place starting the
program again, reaching its main: a further path, climbed --depth more levels). tag says why an edge is uncertain,
null when it is resolved. test edges are test code: listed, counted in set_aside, climbed only with --tests. An entry
is a definition the climb ends at: kind none (no caller, no link) or callback (an external trait's). A target naming
no single definition prints {error} and exits 1.
"""
import hashlib, importlib.util, json, os, pickle, re, subprocess, sys, tempfile, threading, time
from collections import Counter, defaultdict
from importlib.machinery import SourceFileLoader

try:
    import msgspec
except ModuleNotFoundError:
    print("trace: needs the msgspec module: pacman -S python-msgspec, or pip install msgspec", file=sys.stderr)
    sys.exit(2)

# explore, beside this script, decodes rg's and ast-grep's JSON, decides test code and owner chains, and prepares
# the files ast-grep parses; trace reuses it for all of these
EXPLORE = os.path.join(os.path.dirname(os.path.realpath(__file__)), "explore")
sys.dont_write_bytecode = True          # no __pycache__ beside the scripts
_loader = SourceFileLoader("explore", EXPLORE)
X = importlib.util.module_from_spec(importlib.util.spec_from_loader("explore", _loader))
_loader.exec_module(X)

KINDS = {
    "java": {"class_declaration": "type", "interface_declaration": "type", "enum_declaration": "type",
             "record_declaration": "type", "method_declaration": "fn", "constructor_declaration": "fn"},
    "rust": {"function_item": "fn", "function_signature_item": "fn", "impl_item": "impl", "trait_item": "type",
             "struct_item": "type", "enum_item": "type", "mod_item": "mod"},
}
EXT = {"java": "java", "rs": "rust"}
HANDOFF = re.compile(r"Class\.forName|\.newInstance\(|new Thread\b|\.start\(\)|Runtime\.getRuntime\(\)\.exec|ProcessBuilder|"
                     r"Command::new|thread::spawn|tokio::spawn|\.spawn\(|mpsc::|\.send\(|\.recv\(|try_recv\(|getProperty\(|"
                     r"add\w*Listener\(|set_timer|set_time_alert|subscribe\w*\(|publish\w*\(|invoke\(|ExecutorService|\.submit\(|\.execute\(")
WRAPPERS = ("Option", "Result", "Vec", "Box", "Rc", "Arc", "RefCell")


def sh(args, **kw):
    # rg given no path reads stdin when stdin is not a terminal, so no child reads it
    return subprocess.run(args, capture_output=True, stdin=subprocess.DEVNULL, **kw)


def lang_of(p):
    return EXT.get(p.rsplit(".", 1)[-1]) if "." in p else None


lines = X.read_lines


class Captures(msgspec.Struct, gc=False):
    NAME: X.Capture | None = None
    TYPE: X.Capture | None = None
    TRAIT: X.Capture | None = None
    RET: X.Capture | None = None


class MetaVariables(msgspec.Struct, gc=False):
    single: Captures


class SgMatch(msgspec.Struct, gc=False):
    """A definition or a Java supertype as ast-grep's JSON gives it, decoded into only the fields trace reads."""
    file: str
    range: X.Range
    ruleId: str
    metaVariables: MetaVariables | None = None


SG = msgspec.json.Decoder(SgMatch)


# ---------------- ast-grep rules ----------------
# Each rule's id names what its match is; a match's captures name the shape of the parts it found.
# A receiver is captured under the name of its shape: SELF, SUPER, VAR, FIELD, RET (the receiver is the
# result of a call to RET), NEW, PATH, or EXPR for any other expression; no capture means no receiver.
# Definitions and Java supertypes are read from ast-grep's JSON, which gives a definition's end, its name's place
# and the byte offsets that tie a supertype to its class; everything else from
# its one-line report, since the JSON repeats the text of every node a relational rule visits and so grows with
# the square of a chain's length. A reported node's end follows from its start and its text.

def rule(id_, lang, body, utils=None):
    r = {"id": id_, "language": lang, "rule": body}
    if utils:
        r["utils"] = utils
    return r


def def_rules(lang):
    out = []
    for kind in KINDS[lang]:
        parts = []
        if kind == "impl_item":
            parts += [{"has": {"field": "type", "pattern": "$TYPE"}}, {"any": [{"has": {"field": "trait", "pattern": "$TRAIT"}}, {"kind": kind}]}]
        else:
            parts.append({"has": {"field": "name", "pattern": "$NAME"}})
        if kind == "method_declaration":
            parts.append({"has": {"field": "type", "pattern": "$RET"}})
        if kind in ("function_item", "function_signature_item"):
            parts.append({"any": [{"has": {"field": "return_type", "pattern": "$RET"}}, {"kind": kind}]})
        out.append(rule("def " + kind, lang, {"kind": kind, "all": parts}))
    return out


def java_receiver(pos):
    """Receiver shapes of the child at POS (a field or nthChild relation)."""
    return [
        {"has": dict(pos, kind="this", pattern="$SELF")},
        {"has": dict(pos, kind="super", pattern="$SUPER")},
        {"has": dict(pos, any=[{"kind": "identifier"}, {"kind": "type_identifier"}], pattern="$VAR")},
        {"has": dict(pos, kind="field_access", has={"field": "field", "pattern": "$FIELD"})},
        {"has": dict(pos, kind="method_invocation", has={"field": "name", "pattern": "$RET"})},
        {"has": dict(pos, kind="object_creation_expression", has={"field": "type", "pattern": "$NEW"})},
        {"has": dict(pos, pattern="$EXPR")},
    ]


JAVA_TYPE = {"any": [{"kind": "type_identifier"}, {"kind": "generic_type"}, {"kind": "scoped_type_identifier"}]}


def java_rules():
    decl_parent = {"any": [{"kind": "local_variable_declaration"}, {"kind": "field_declaration"}, {"kind": "constant_declaration"}],
                   "has": {"field": "type", "pattern": "$TYPE"}}
    sites = [
        rule("call", "java", {"kind": "identifier", "inside": {
            "kind": "method_invocation", "field": "name",
            "any": java_receiver({"field": "object"}) + [{"kind": "method_invocation", "not": {"has": {"field": "object", "regex": "^"}}}]}}),
        # Foo::bar: the name is the last child and not the first; a constructor reference Foo::new has none
        rule("ref", "java", {"kind": "identifier", "nthChild": {"position": 1, "reverse": True}, "not": {"nthChild": 1},
                             "inside": {"kind": "method_reference", "any": java_receiver({"nthChild": 1})}}),
        rule("new", "java", dict(JAVA_TYPE, inside={"kind": "object_creation_expression", "field": "type"})),
        rule("decl", "java", {"kind": "identifier", "inside": {"kind": "variable_declarator", "field": "name", "inside": decl_parent}}),
        rule("decl", "java", {"kind": "identifier", "inside": {
            "field": "name", "any": [{"kind": "formal_parameter"}, {"kind": "enhanced_for_statement"}, {"kind": "resource"}],
            "has": {"field": "type", "pattern": "$TYPE"}}}),
        rule("decl", "java", {"kind": "identifier", "inside": {
            "kind": "catch_formal_parameter", "field": "name", "has": {"kind": "catch_type", "pattern": "$TYPE"}}}),
        # (Sup) Class.forName(name)...: the cast's type
        rule("cast", "java", dict(JAVA_TYPE, inside={"kind": "cast_expression", "field": "type", "has": {
            "field": "value", "stopBy": "end", "kind": "method_invocation",
            "all": [{"has": {"field": "name", "regex": "^forName$"}}, {"has": {"field": "object", "regex": "^Class$"}}]}})),
        rule("comments", "java", {"any": [{"kind": "line_comment"}, {"kind": "block_comment"}]}),
        rule("strings", "java", {"any": [{"kind": "string_literal"}, {"kind": "character_literal"}]}),
        rule("imports", "java", {"kind": "import_declaration"}),
    ]
    nodes = [
        rule("super", "java", dict(JAVA_TYPE, inside={"any": [
            {"kind": "superclass"},
            {"kind": "type_list", "inside": {"any": [{"kind": "super_interfaces"}, {"kind": "extends_interfaces"}]}}]})),
    ]
    return sites, nodes


def rust_callee(cap):
    """Callee shapes that capture the called function's name as CAP."""
    plain = [{"kind": "identifier", "pattern": cap},
             {"kind": "field_expression", "has": {"field": "field", "pattern": cap}},
             {"kind": "scoped_identifier", "has": {"field": "name", "pattern": cap}}]
    return plain + [{"kind": "generic_function", "has": {"field": "function", "any": plain}}]


def rust_receiver(pos):
    """Receiver shapes of the child at POS; x? and x.await are looked through to x."""
    basic = [{"kind": "self", "pattern": "$SELF"},
             {"kind": "identifier", "pattern": "$VAR"},
             {"kind": "field_expression", "has": {"field": "field", "pattern": "$FIELD"}},
             {"kind": "call_expression", "has": {"field": "function", "any": rust_callee("$RET")}}]
    wrapped = {"any": [{"kind": "try_expression"}, {"kind": "await_expression"}], "has": {"nthChild": 1, "any": basic}}
    return [{"has": dict(pos, any=basic + [wrapped])}, {"has": dict(pos, pattern="$EXPR")}]


RUST_PATH = [{"has": {"field": "path", "kind": "scoped_identifier", "has": {"field": "name", "pattern": "$PATH"}}},
             {"has": {"field": "path", "kind": "generic_type", "has": {"field": "type", "pattern": "$PATH"}}},
             {"has": {"field": "path", "pattern": "$PATH"}},
             {"kind": "scoped_identifier"}]
RUST_CALLED = [{"inside": {"kind": "call_expression", "field": "function"}},
               {"inside": {"kind": "generic_function", "field": "function", "inside": {"kind": "call_expression", "field": "function"}}}]
# the leading path of a let's value, as in `let x = Foo::new(a).unwrap()` or `let x = &mut foo(a)?`
RUST_LEAD = {"lead": {"any": [
    {"kind": "scoped_identifier", "pattern": "$LEAD"},
    {"kind": "identifier", "pattern": "$LEAD"},
    {"kind": "struct_expression", "has": {"field": "name", "pattern": "$LEAD"}},
    {"kind": "call_expression", "has": {"field": "function", "matches": "lead"}},
    {"kind": "field_expression", "has": {"field": "value", "matches": "lead"}},
    {"kind": "generic_function", "has": {"field": "function", "matches": "lead"}},
    {"kind": "reference_expression", "has": {"field": "value", "matches": "lead"}},
    {"any": [{"kind": "try_expression"}, {"kind": "await_expression"}], "has": {"nthChild": 1, "matches": "lead"}}]}}


def rust_rules():
    sites = [
        rule("call", "rust", {"kind": "field_identifier", "inside": {
            "kind": "field_expression", "field": "field", "all": [{"any": RUST_CALLED}, {"any": rust_receiver({"field": "value"})}]}}),
        rule("call", "rust", {"kind": "identifier", "any": RUST_CALLED}),
        rule("call", "rust", {"kind": "identifier", "inside": {
            "kind": "scoped_identifier", "field": "name", "all": [{"any": RUST_CALLED}, {"any": RUST_PATH}]}}),
        # Type::name used as a value, as in .map(Self::name); not an import, a macro name or a longer path's prefix
        rule("ref", "rust", {"kind": "identifier", "inside": {
            "kind": "scoped_identifier", "field": "name",
            "not": {"any": RUST_CALLED + [
                {"inside": {"kind": "use_declaration", "stopBy": "end"}},
                {"inside": {"field": "path", "any": [{"kind": "scoped_identifier"}, {"kind": "scoped_type_identifier"}]}},
                {"inside": {"kind": "macro_invocation", "field": "macro"}}]},
            "any": RUST_PATH}}),
        rule("new", "rust", {"any": [{"kind": "type_identifier"}, {"kind": "scoped_type_identifier"}, {"kind": "generic_type_with_turbofish"}],
                             "inside": {"kind": "struct_expression", "field": "name"}}),
        rule("decl", "rust", {"kind": "identifier", "inside": {
            "kind": "parameter", "field": "pattern", "has": {"field": "type", "pattern": "$TYPE"}}}),
        rule("decl", "rust", {"any": [{"kind": "field_identifier"}, {"kind": "identifier"}], "inside": {
            "any": [{"kind": "field_declaration"}, {"kind": "const_item"}, {"kind": "static_item"}], "field": "name",
            "has": {"field": "type", "pattern": "$TYPE"}}}),
        rule("decl", "rust", {"kind": "identifier", "inside": {
            "kind": "let_declaration", "field": "pattern",
            "any": [{"has": {"field": "type", "pattern": "$TYPE"}}, {"has": {"field": "value", "matches": "lead"}}]}}, RUST_LEAD),
        # the arguments of a macro or an attribute and a macro_rules! expansion are tokens to tree-sitter;
        # they are parsed again as code on their own
        rule("macro", "rust", {"kind": "token_tree", "any": [
            {"inside": {"kind": "macro_invocation"}}, {"inside": {"kind": "attribute", "field": "arguments"}},
            {"inside": {"kind": "macro_rule", "field": "right"}}]}),
        rule("comments", "rust", {"any": [{"kind": "line_comment"}, {"kind": "block_comment"}]}),
        rule("strings", "rust", {"any": [{"kind": "string_literal"}, {"kind": "raw_string_literal"}, {"kind": "char_literal"}]}),
        rule("imports", "rust", {"kind": "use_declaration"}),
    ]
    return sites, []


# the fields of a site's one-line report, in order; E is the first character of EXPR, enough to tell it is there
FIELDS = ("TEXT", "SELF", "SUPER", "VAR", "FIELD", "RET", "NEW", "PATH", "E", "TYPE", "LEAD")
SHAPES = ("SELF", "SUPER", "VAR", "FIELD", "RET", "NEW", "PATH", "E")


def reported(r):
    r = dict(r, severity="info", message="\x1f".join("$" + f for f in FIELDS), rule=dict(r["rule"], pattern="$TEXT"))
    if "$EXPR" in json.dumps(r["rule"]):
        r["transform"] = {"E": {"substring": {"source": "$EXPR", "endChar": 1}}}
    return r


def docs(rules):
    return "\n---\n".join(json.dumps(r) for r in rules)


RULES = {}
for _lang, (_sites, _nodes) in (("java", java_rules()), ("rust", rust_rules())):
    RULES[_lang] = (docs(def_rules(_lang) + _nodes), docs(reported(r) for r in _sites))
MACRO_RULES = {"rust": (None, RULES["rust"][1])}


def sg_scan(files, rules, tmp):
    """Matches in FILES of RULES, {language: (JSON rules or None, reported rules)}: [(original path, SgMatch)],
    [(original path, rule id, line, column, {field: text})], and {path: reason} for the files ast-grep did not parse,
    the reason as explore's sg_skip gives it. A file ast-grep would mishandle is scanned from explore's UTF-8 copy
    (sg_source), which keeps its lines. Each run's output is read as it arrives, on a thread of its own."""
    src, jobs = {}, []
    for n, f in enumerate(files):
        with open(f, "rb") as fh:
            src[os.path.normpath(X.sg_source(f, fh.read(), n, tmp))] = f
    for lang, docs_ in rules.items():
        scanned = [c for c, f in src.items() if lang_of(f) == lang]
        for i in range(0, len(scanned), 800):
            for doc, style in zip(docs_, (["--json=stream"], ["--report-style", "short"])):
                if doc:
                    jobs.append((style[0], scanned[i:i + 800], doc))
    done = [None] * len(jobs)

    def run(i):
        style, batch, doc = jobs[i]
        try:
            with tempfile.TemporaryFile() as err:
                proc = subprocess.Popen(["ast-grep", "scan", "--inline-rules", doc, style, *(["short"] if style == "--report-style" else []),
                                         "--inspect", "entity", "--", *batch], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=err)
                with proc:
                    if style == "--json=stream":
                        out = [(src.get(os.path.normpath(m.file), m.file), m) for m in map(SG.decode, proc.stdout)]
                    else:
                        # PATH:LINE:COLUMN: note[RULE]: FIELDS, where a field spanning lines continues on the next ones
                        out = []
                        for raw in proc.stdout:
                            line = raw.decode("utf-8", "replace").rstrip("\n")
                            where, sep, rest = line.partition(": note[")
                            path, _, at = where.rpartition(":")
                            path, _, ln = path.rpartition(":")
                            if sep and path in src:
                                rid, _, msg = rest.partition("]: ")
                                out.append([src[path], rid, int(ln), int(at) - 1, msg])
                            else:
                                out[-1][4] += "\n" + line
                err.seek(0)
                done[i] = (style, batch, out, proc.returncode != 0, X.sg_entities(err.read().decode(errors="replace").splitlines()))
        except BaseException as e:      # raised again below, in the caller's thread
            done[i] = e
    threads = [threading.Thread(target=run, args=(i,)) for i in range(len(jobs))]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    for d in done:
        if isinstance(d, BaseException):
            raise d
    nodes, sites, skipped = [], [], {}
    for style, batch, out, failed, entity in done:
        (nodes if style == "--json=stream" else sites).extend(out)
    found = {f for f, _ in nodes} | {s[0] for s in sites}
    for style, batch, out, failed, entity in done:
        for c in batch:
            why = X.sg_skip(entity.get(c), failed, src[c] in found)
            if why:
                skipped[src[c]] = why
    sites = [(f, rid, ln, col, {k: v for k, v in zip(FIELDS, msg.split("\x1f")) if v}) for f, rid, ln, col, msg in sites]
    return nodes, sites, skipped


# ---------------- index ----------------
def type_head(s):
    """The type a type or path expression names: &mut a::Foo<T> -> Foo."""
    s = s.strip()
    while s[:1] in ("&", "*") or s.startswith(("mut ", "dyn ", "impl ", "'")):
        s = s[1:].lstrip() if s[:1] in ("&", "*") else s.split(None, 1)[1] if " " in s else ""
    s = s.split("<", 1)[0].split("[", 1)[0].split("(", 1)[0].strip().rstrip(":")
    return s.replace("::", ".").rsplit(".", 1)[-1]


def caps(s):
    return [x for x in re.findall(r"\b[A-Z]\w*", s)]


def head_of(lang, text):
    head = " ".join(re.split(r"[{;]", text, maxsplit=1)[0].split())
    return re.sub(r"@\w+(\([^)]*\))?\s*", "", head) if lang == "java" else head


def single(lang, path, m, name):
    """(text, line, column) of the capture NAME of the match M in PATH, or None; its text is read from PATH by its
    range, as explore's name_of reads it, so that a copy ast-grep parsed in its place gives the original's text."""
    c = getattr(m.metaVariables.single, name) if m.metaVariables else None
    return c and (X.name_of(lang, path, c), c.range.start.line + 1, c.range.start.column)


def head_text(path, rng):
    """The text of the node at RNG in PATH, from its start to the end of the line holding its first { or ;, or to its
    end: as much of it as head_of reads."""
    ls, out = lines(path), []
    for k in range(rng.start.line, rng.end.line + 1):
        out.append(ls[k][rng.start.column if k == rng.start.line else 0:rng.end.column if k == rng.end.line else None])
        if "{" in out[-1] or ";" in out[-1]:
            break
    return "\n".join(out)


def site_record(rid, ln, col, c):
    """(category, record) of one reported site, or None."""
    if rid in ("call", "ref"):
        shape = next((k for k in SHAPES if k in c), None)
        return "calls", (rid, c["TEXT"], ln, col, None if shape is None else ("EXPR", "") if shape == "E" else (shape, c[shape]))
    if rid == "new":
        name = type_head(c["TEXT"])
        off = c["TEXT"].rfind(name) if "\n" not in c["TEXT"] else 0
        return "calls", ("new", name, ln, col + max(off, 0), None)
    if rid == "decl":
        if "TYPE" in c:
            return "decls", (ln, c["TEXT"], "type", c["TYPE"])
        if "LEAD" in c:
            return "decls", (ln, c["TEXT"], "lead", c["LEAD"])
        return None
    if rid == "cast":
        return "casts", (ln, type_head(c["TEXT"]))
    if rid in ("comments", "strings", "imports"):
        t = c["TEXT"]
        return "spans", (ln, col, ln + t.count("\n"), len(t) - t.rfind("\n") - 1 if "\n" in t else col + len(t), rid)
    if rid == "macro":
        return "macros", (ln, col, c["TEXT"])
    raise ValueError("no record for rule " + rid)


def macro_sites(bodies, tmp):
    """Sites inside the arguments of Rust macros and attributes, parsed as the arguments of a call:
    {path: {category: [records]}}. BODIES are (path, line, col, argument tree text, its delimiters included);
    a site maps back to the line and column it has in PATH."""
    out = defaultdict(lambda: defaultdict(list))
    pre = "fn __m() { __f("
    for depth in range(6):
        bodies = [b for b in bodies if "(" in b[3][1:-1]]
        if not bodies:
            break
        per = defaultdict(list)
        for b in bodies:
            per[b[0]].append(b)
        files, where = [], {}
        for n, (p, bs) in enumerate(per.items()):
            # line k of the copy is line at[k][0] of P, shifted right by at[k][1] columns
            syn, at, text = os.path.join(tmp, "m%d_%d.rs" % (depth, n)), [], []
            for _, l0, c0, body in bs:
                inner = body[1:-1]
                for k in range(inner.count("\n") + 1):
                    at.append((l0 + k, c0 + 1 - len(pre) if k == 0 else 0))
                text.append(pre + inner + "); }")
            with open(syn, "w", encoding="utf-8") as o:
                o.write("\n".join(text) + "\n")
            files.append(syn)
            where[syn] = (p, at)
        _, sites, _ = sg_scan(files, MACRO_RULES, tmp)
        bodies = []
        for syn, rid, ln, col, c in sites:
            p, at = where[syn]
            cat, rec = site_record(rid, ln, col, c) or (None, None)
            l0, d = at[ln - 1]
            if cat == "macros":
                bodies.append((p, at[rec[0] - 1][0], rec[1] + at[rec[0] - 1][1], rec[2]))
            elif cat == "calls" and rec[1] not in ("__f", "__m"):
                out[p]["calls"].append(rec[:2] + (l0, col + d) + rec[4:])
            elif cat == "decls":
                out[p]["decls"].append((l0,) + rec[1:])
    return out


def build_index(root="."):
    t0 = time.time()
    key = hashlib.sha1(os.path.realpath(root).encode())
    for code in (__file__, EXPLORE):          # a new version of this script or of explore reads a new cache
        with open(code, "rb") as fh:
            key.update(b"\0" + fh.read())
    key = key.hexdigest()[:12]
    cache = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "explore-trace", key + ".ast.pkl")
    files = [f for f in sh(["rg", "--files", "--no-config", "-t", "java", "-t", "rust"]).stdout.decode(errors="replace").split("\n") if f]
    stat = {f: (os.path.getmtime(f), os.path.getsize(f)) for f in files}
    old = {}
    if os.path.exists(cache):
        with open(cache, "rb") as fh:
            old = pickle.load(fh)
    idx = {f: old[f] for f in files if f in old and old[f]["stat"] == stat[f]}
    todo = [f for f in files if f not in idx]
    if todo:
        with tempfile.TemporaryDirectory() as tmp:
            defs, sites, supers, bodies = defaultdict(list), defaultdict(lambda: defaultdict(list)), defaultdict(list), []
            nodes, reports, skipped = sg_scan(todo, RULES, tmp)
            for f, m in nodes:
                if m.ruleId.startswith("def "):
                    defs[f].append((lang_of(f), m.ruleId[4:], m))
                else:
                    supers[f].append((m.range.byteOffset.start, type_head(X.name_of(lang_of(f), f, m))))
            for f, rid, ln, col, c in reports:
                rec = site_record(rid, ln, col, c)
                if rec and rec[0] == "macros":
                    bodies.append((f,) + rec[1])
                elif rec:
                    sites[f][rec[0]].append(rec[1])
            for f, cats in macro_sites(bodies, tmp).items():
                for cat, recs in cats.items():
                    sites[f][cat] += recs
            for f in todo:
                out = []
                for lang, node, m in defs.get(f, []):
                    kind = KINDS[lang][node]
                    ret = single(lang, f, m, "RET")
                    if kind == "impl":
                        trait = single(lang, f, m, "TRAIT")
                        name, extra = type_head(single(lang, f, m, "TYPE")[0]), [type_head(trait[0])] if trait else []
                        at = (m.range.start.line + 1, m.range.start.column)
                    else:
                        name, ln, col = single(lang, f, m, "NAME")
                        at = (ln, col)
                        if kind == "type":
                            b = m.range.byteOffset
                            inner = [x.range.byteOffset for l, k, x in defs[f] if x is not m and KINDS[l][k] == "type"
                                     and b.start <= x.range.byteOffset.start and x.range.byteOffset.end <= b.end]
                            # a super belongs to the innermost type whose range holds it
                            extra = [t for o, t in supers.get(f, []) if b.start <= o < b.end and not any(x.start <= o < x.end for x in inner)]
                        elif kind == "fn" and ret:
                            extra = caps(ret[0]) if lang == "rust" else [type_head(ret[0])] if ret[0] != "void" else []
                        else:
                            extra = []
                    out.append((m.range.start.line + 1, m.range.end.line + 1, kind, name, extra, head_of(lang, head_text(f, m.range))[:200], at, node))
                out.sort(key=lambda d: (d[0], -d[1]))
                s = {k: sorted(v, key=lambda r: r[:4]) for k, v in sites.get(f, {}).items()}
                idx[f] = {"stat": stat[f], "defs": out, "sites": pickle.dumps(s, protocol=5), "skipped": skipped.get(f)}
        os.makedirs(os.path.dirname(cache), exist_ok=True)
        with open(cache + ".tmp", "wb") as fh:
            pickle.dump(idx, fh, protocol=5)
        os.replace(cache + ".tmp", cache)
    return idx, {"files": len(files), "reparsed": len(todo), "ms": int((time.time() - t0) * 1000)}


NO_SITES = {}


class Repo:
    def __init__(self):
        self.idx, self.stats = build_index()
        self.by_name = defaultdict(list)      # name -> [(file, def)]
        self.supers = defaultdict(set)
        self.types = set()
        self.skipped = {f: r["skipped"] for f, r in self.idx.items() if r["skipped"]}
        self._sites = {}
        for f, rec in self.idx.items():
            for d in rec["defs"]:
                self.by_name[d[3]].append((f, d))
                if d[2] == "type":
                    self.types.add(d[3])
                    self.supers[d[3]].update(d[4])
                elif d[2] == "impl":
                    self.supers[d[3]].update(d[4])
        self.subs = defaultdict(set)
        for t, ss in self.supers.items():
            for s in ss:
                self.subs[s].add(t)

    def sites(self, f, cat):
        """The file's records of CAT: calls (kind, name, line, col, receiver), decls (line, var, how, text),
        spans (line, col, end line, end col, comments|strings|imports), casts (line, type)."""
        if f not in self._sites:
            rec = self.idx.get(f)
            self._sites[f] = pickle.loads(rec["sites"]) if rec else NO_SITES
        return self._sites[f].get(cat, ())

    def span_at(self, f, line, col):
        """comments, strings or imports when the code at LINE:COL lies in one, else None."""
        for sl, sc, el, ec, cat in self.sites(f, "spans"):
            if (sl, sc) <= (line, col) < (el, ec):
                return cat
        return None

    def closure(self, t, rel):
        seen, todo = set(), [t]
        while todo:
            for n in rel.get(todo.pop(), ()):
                if n not in seen:
                    seen.add(n)
                    todo.append(n)
        return seen

    def chain(self, f, line):
        return [d for d in self.idx.get(f, {"defs": []})["defs"] if d[0] <= line <= d[1]]

    def owner_type(self, chain):
        for d in reversed(chain):
            if d[2] in ("type", "impl"):
                return d[3]
        return None

    def label(self, f, chain):
        fns = [d for d in chain if d[2] == "fn"]
        own = self.owner_type(chain)
        sep = "::" if f.endswith(".rs") else "."
        if fns:
            return (own + sep if own else "") + fns[-1][3]
        return own or "(top level)"

    def is_test(self, f, chain):
        """Whether code in F, inside the definitions CHAIN, is test code, as explore's is_test decides it."""
        return X.is_test(f, [X.Def(d[0], d[1], d[5], d[7], d[3]) for d in chain])

    def owners(self, f, d):
        """The definitions that hold the definition D of F, outermost first, as explore's owner_chain gives them."""
        return X.owner_chain(self.idx[f]["defs"], d[0])


def rg_rows(pattern, extra=(), paths=()):
    """(path, line number, first line) of each match of rg's PATTERN, its JSON read as it arrives."""
    rg, err = X.rg_json([*extra, "-e", pattern, "--", *paths])
    rows = []
    with rg, err:
        for raw in rg.stdout:
            if raw.startswith(b'{"type":"match"'):
                d = X.RG.decode(raw).data
                rows.append((X.path_of(d.path), d.line_number, X.text_of(d.lines)[0].rstrip("\n").split("\n")[0]))
        rg.wait()
    return rows


# ---------------- receiver resolution ----------------
def decl_types(repo, f, fn, line, var, lang):
    """(type names VAR may have at LINE, whether F's own text names them) from the nearest declaration in the
    enclosing fn, else the last in the file; a type taken from a called function's return type is not F's text."""
    ds = [d for d in repo.sites(f, "decls") if d[1] == var]
    for s, e in ([(fn[0], line)] if fn else []) + [(1, float("inf"))]:
        for dl, _, how, text in sorted((d for d in ds if s <= d[0] <= e), reverse=True):
            if how == "type":
                if lang == "java":
                    t = type_head(text)
                    if t[:1].isupper():
                        return [t], True
                else:
                    return caps(text) or ["?"], True
            else:                       # Rust let without a type: the value's leading path
                segs = text.split("::")
                c = [x for x in segs if x[:1].isupper()]
                if c:
                    return c[:1], True
                r = ret_types(repo, type_head(segs[-1]))
                if r:
                    return r, False
    return [], False


def ret_types(repo, name):
    out = set()
    for f, d in repo.by_name.get(name, []):
        if d[2] != "fn":
            continue
        if f.endswith(".java"):
            out.update(d[4])
        else:
            own = repo.owner_type(repo.chain(f, d[0]))
            out.update(own if c == "Self" else c for c in d[4] if c not in WRAPPERS)
    return sorted(x for x in out if x)


def receiver(repo, f, rec, lang):
    """(types, how, proven) for the call record REC; types None when the call has no receiver. PROVEN is whether the
    types were read from F's own text, so that a type name means the type F's scope gives that name, rather than
    guessed from a called function's declared return type or not known."""
    _, _, lnum, _, recv = rec
    chain = repo.chain(f, lnum)
    own = repo.owner_type(chain)
    if recv is None:
        return None, own, True
    shape, tok = recv
    if shape == "SELF":
        return [own or "?"], tok, True
    if shape == "SUPER":
        return sorted(repo.supers.get(own, [])) or ["?"], "super", True
    if shape == "NEW":
        return [type_head(tok)], "new", True
    if shape == "PATH":
        t = type_head(tok)
        if t == "Self":
            return [own or "?"], "Self", True
        return ([t], "static", True) if t[:1].isupper() else (["mod:" + t], "path", True)
    if shape == "RET":
        if tok[:1].isupper() and lang == "rust":
            return [tok], "ctor", True
        r = ret_types(repo, tok)
        return (r or ["?"]), "ret of " + tok, False
    if shape in ("VAR", "FIELD"):
        if tok == "Self":
            return [own or "?"], tok, True
        if tok[:1].isupper() and not tok.isupper():
            return [tok], "static", True
        fn = next((d for d in reversed(chain) if d[2] == "fn"), None) if shape == "VAR" else None
        t, proven = decl_types(repo, f, fn, lnum, tok, lang)
        return (t or ["?"]), ("var " if shape == "VAR" else "field ") + tok, proven
    return ["?"], "expr", False


def other_same_name(repo, p, tfile, owner):
    """True when OWNER is also defined in P itself and the target lives elsewhere: P means its own type."""
    homes = {f for f, d in repo.by_name.get(owner, []) if d[2] == "type"}
    return len(homes) > 1 and p in homes and p != tfile


def verdict(repo, target_owner, tfile, types, how, lang, tname_):
    """yes | dyn (through a supertype) | maybe | no"""
    if target_owner is None:                       # a free function
        if types is None:
            return "yes"
        if types and types[0].startswith("mod:"):
            mod = types[0][4:]
            stem = os.path.basename(tfile).rsplit(".", 1)[0]
            parent = os.path.basename(os.path.dirname(tfile))
            return "yes" if mod in (stem, parent, "crate", "super", "self") else "no"
        return "no"
    if types is None:                              # bare call inside a type: Java implicit this
        own = how
        if lang == "rust":
            return "no"
        types = [own] if own else ["?"]
    rel_down = repo.closure(target_owner, repo.subs) | {target_owner}
    rel_up = repo.closure(target_owner, repo.supers)
    if any(t in rel_down for t in types):
        return "yes"
    if any(t in rel_up and t in repo.types for t in types):
        return "dyn"
    if any(t in rel_up for t in types):
        return "no"
    known = [t for t in types if t in repo.types]
    if types and all(t.startswith("mod:") for t in types):
        return "no"
    if known and len(known) == len([t for t in types if t != "?"]) and "?" not in types:
        # generic bound: a type parameter whose bound is a supertype
        return "no"
    if types and "?" not in types and all(len(t) > 1 for t in types) and not any(t in repo.supers for t in types):
        return "no" if lang == "java" else "maybe"
    return "maybe"


def find_targets(repo, target):
    parts = re.split(r"::|\.|#", target)
    name, owner = parts[-1], (parts[-2] if len(parts) > 1 else None)
    out = []
    for f, d in repo.by_name.get(name, []):
        own = repo.owner_type(repo.owners(f, d)) if d[2] == "fn" else None
        if owner and d[2] == "fn" and own != owner:
            continue
        out.append((f, d, own))
    return out


def word_cols(text, name):
    return [m.start() for m in re.finditer(r"\b" + re.escape(name) + r"\b", text)]


def bound_locally(repo, p, ch, line, name):
    """Whether NAME is a parameter or a let binding of the Rust function enclosing LINE in P, before LINE: a bare call
    of NAME there calls that binding."""
    fn = next((x for x in reversed(ch) if x[2] == "fn"), None)
    if fn is None:
        return False
    n = re.escape(name)
    return bool(re.search(r"[(,]\s*(?:mut\s+)?%s\s*:" % n, fn[5])
                or re.search(r"\blet\s+(?:mut\s+)?%s\b" % n, "\n".join(lines(p)[fn[0] - 1:line])))


def callers_once(repo, f, d, own, include_tests):
    """Call sites of the definition D (owner OWN) as (path, line, text, chain, verdict, text mark, test, tag), and the
    counts of what was set aside. The verdict is yes, dyn, maybe or guess (a receiver whose type name has several
    definitions, the calling file's own among them, not proven to be that one); the tag says why a site is not
    resolved. Test sites are kept and, unless INCLUDE_TESTS, also counted as set aside."""
    name, lang = d[3], lang_of(f)
    rows = rg_rows(r"\b" + re.escape(name) + r"\b", ["-t", lang])
    kept, aside = [], Counter()
    is_ctor = lang == "java" and own == name
    for p in sorted({r[0] for r in rows}):         # rg gives files in the order its threads finish
        ls, claimed = lines(p), set()
        for rec in repo.sites(p, "calls"):
            kind, nm, n, col, _ = rec
            if nm != name or (kind == "new") != is_ctor:
                continue
            claimed.add((n, col))
            ch = repo.chain(p, n)
            if is_ctor:
                v, how, types, proven = "yes", "new", [name], True
            elif lang == "rust" and own is None and rec[4] is None and p != f and bound_locally(repo, p, ch, n, name):
                aside["local binding"] += 1
                continue
            else:
                types, how, proven = receiver(repo, p, rec, lang)
                v = verdict(repo, own, f, types, how, lang, name)
            tag = None if v == "yes" else "through " + ",".join(types or []) if v == "dyn" else \
                "unresolved receiver: %s" % how if isinstance(how, str) else "unresolved receiver"
            if v != "no" and own and other_same_name(repo, p, f, own):
                # P defines a type named as OWN: it is P's own unless the receiver is not proven to be that type
                if proven and v == "yes":
                    v, types = "no", [own + " of " + os.path.basename(p)]
                else:
                    v, tag = "guess", "%s names %d types and %s defines its own; the receiver (%s, %s) is not proven to be it" % (
                        own, len({g for g, x in repo.by_name[own] if x[2] == "type"}), os.path.basename(p), how,
                        ",".join(types or []) or "no type")
            if v == "no":
                aside["other receiver: " + ",".join(types or [str(how)])] += 1
                continue
            test = repo.is_test(p, ch)
            if test and not include_tests:
                aside["tests"] += 1
            via = "" if v == "yes" else " [via %s]" % ",".join(types or []) if v == "dyn" else \
                " [?%s]" % tag if v == "guess" else " [?%s]" % (how if isinstance(how, str) else "")
            kept.append((p, n, ls[n - 1].strip(), ch, v, via, test, tag))
        names = {x[6] for g, x in repo.by_name.get(name, []) if g == p}
        for n in sorted({r[1] for r in rows if r[0] == p}):
            for col in word_cols(ls[n - 1], name):
                if (n, col) in claimed:
                    continue
                aside["definitions" if (n, col) in names else repo.span_at(p, n, col) or "mentions"] += 1
    return kept, aside


def link_sites(repo, f, d, own):
    """Non-call ways into a method nobody calls: construction of its type, its name in strings and config; test code
    included."""
    out, lang = [], lang_of(f)
    if not own:
        return out
    ext = sorted(s for s in repo.supers.get(own, ()) if s not in repo.types)
    if ext:
        out.append(("callback", None, 0, "%s implements %s, defined outside the repo: the framework calls %s" % (own, ", ".join(ext), d[3]), []))
    # new Own(...) in Java; Own { .. }, Own(..), Own::name(..) and Own::Variant in Rust, where a Rust type that is
    # not pub is constructed only in its own file
    private = lang == "rust" and any(x[2] == "type" and x[3] == own and not x[5].startswith("pub") for x in repo.idx[f]["defs"])
    for p in sorted({r[0] for r in rg_rows(r"\b%s\b" % re.escape(own), ["-t", lang])}):
        if other_same_name(repo, p, f, own) or (private and p != f):
            continue
        seen = set()
        # where P defines its own type of the name, a path through another module, as a::Own, names another type
        homed = lang == "rust" and any(x[2] == "type" and x[3] == own for x in repo.idx[p]["defs"])
        for kind, nm, n, col, recv in repo.sites(p, "calls"):
            hit = (kind == "new" and nm == own) or lang == "rust" and (
                kind in ("call", "ref") and recv and recv[0] == "PATH" and type_head(recv[1]) == own
                and not (homed and re.search(r"(?<!\w)(?!self\b|Self\b)\w+\s*::\s*%s\s*::\s*$" % re.escape(own), lines(p)[n - 1][:col]))
                or kind == "call" and recv is None and nm == own)
            if not hit or n in seen:
                continue
            seen.add(n)
            ch = repo.chain(p, n)
            if repo.owner_type(ch) == own and lang == "rust":
                continue
            out.append(("new", p, n, lines(p)[n - 1].strip(), ch))
    casts = {p for p, _, _ in rg_rows(r"\bforName\b", ["-t", "java"])} if lang == "java" else set()
    for sup in sorted(repo.closure(own, repo.supers)):
        for p in sorted(casts):
            for n, t in repo.sites(p, "casts"):
                ch = repo.chain(p, n)
                if t == sup:
                    impls = sorted(repo.closure(sup, repo.subs) & repo.types)
                    out.append(("reflect-cast to %s (in-repo implementers: %s)" % (sup, ", ".join(impls[:6])), p, n, lines(p)[n - 1].strip(), ch))
    # the type's name inside a string or a non-code file: reflection and configuration
    for p, n, text in rg_rows(r"\b" + re.escape(own) + r"\b", ["-g", "*.{java,rs,properties,xml,conf,cfg,ini,yaml,yml,toml,json,sh,bat,MF}", "--max-filesize", "1M"]):
        code = lang_of(p)
        if code and not any(repo.span_at(p, n, c) == "strings" for c in word_cols(lines(p)[n - 1], own)):
            continue
        if code and not re.search(r'"(?:[\w.]*\.)?' + re.escape(own) + r'"', text):
            continue
        ch = repo.chain(p, n) if code else []
        if code:
            m = re.search(r"\b([A-Z_][A-Z0-9_]+)\s*=\s*\"", text)
            out.append(("reflect", p, n, text.strip(), ch))
            if m:
                for p2, n2, t2 in rg_rows(r"\b" + m.group(1) + r"\b", ["-t", "java", "-t", "rust"]):
                    if (p2, n2) != (p, n) and any(repo.span_at(p2, n2, c) != "comments" for c in word_cols(lines(p2)[n2 - 1], m.group(1))):
                        out.append(("reflect via " + m.group(1), p2, n2, t2.strip(), repo.chain(p2, n2)))
        else:
            if text.lstrip().startswith(("#", "!", "<!--")):
                continue
            out.append(("config", p, n, text.strip(), []))
            m = re.match(r"\s*([\w.\-]+)\s*[=:]", text) or re.search(r"\b(?:id|name|key)\s*=\s*\"([^\"]+)\"", text)
            if m:
                key = m.group(1)
                for p2, n2, t2 in rg_rows(re.escape('"' + key + '"'), ["-t", "java", "-t", "rust"]):
                    out.append(("reads key " + key, p2, n2, t2.strip(), repo.chain(p2, n2)))
    return out


# ---------------- spawn of the program itself ----------------
PROGRAM_FILES = ("Cargo.toml", "pom.xml", "build.gradle", "build.gradle.kts", "build.xml")


def program_root(p):
    """The nearest directory above P holding a build file, "" when none does: the program P's code is built into."""
    d = os.path.dirname(os.path.normpath(p))
    while d:
        if any(os.path.isfile(os.path.join(d, b)) for b in PROGRAM_FILES):
            return d
        d = os.path.dirname(d)
    return ""


def is_main(repo, f, d):
    """Whether D is where a program starts: a free Rust fn main other than a build script's, a static Java main."""
    if d[2] != "fn" or d[3] != "main":
        return False
    if f.endswith(".rs"):
        return repo.owner_type(repo.owners(f, d)) is None and os.path.basename(f) != "build.rs"
    return re.search(r"\bstatic\b", d[5]) is not None


def balanced(text, i):
    """The index of the bracket closing the one at I in TEXT, and the indexes of the commas at its top level;
    None when it does not close. Generic angle brackets count, an arrow's > does not."""
    depth, commas, k = 0, [], i
    while k < len(text):
        c = text[k]
        if c == "-" and text[k + 1:k + 2] == ">":
            k += 2
            continue
        if c in "([{<":
            depth += 1
        elif c in ")]}>":
            depth -= 1
            if depth == 0:
                return k, commas
        elif c == "," and depth == 1:
            commas.append(k)
        k += 1
    return None


def rust_params(repo, g, x):
    """The parameters of the Rust function X in G as (name or None, is self), in order."""
    text = "\n".join(lines(g)[x[0] - 1:x[1]])
    m = re.search(r"\bfn\s+%s\s*(?:<[^(]*>)?\s*\(" % re.escape(x[3]), text)
    b = m and balanced(text, m.end() - 1)
    if not b:
        return []
    end, commas = b
    cuts = [m.end() - 1] + commas + [end]
    out = []
    for a, z in zip(cuts, cuts[1:]):
        part = text[a + 1:z].strip()
        if not part:
            continue
        if re.match(r"(?:&\s*(?:'\w+\s+)?)?(?:mut\s+)?self\b", part):
            out.append((None, True))
        else:
            name = re.match(r"(?:mut\s+)?(\w+)\s*:", part)
            out.append((name and name.group(1), False))
    return out


def argument_of(repo, p, n, col):
    """The functions and parameter names that the code at line N, column COL of P is passed to as an argument of the
    innermost call holding it: [(file, definition, parameter)]."""
    ls = lines(p)
    text = "\n".join(ls[n - 1:n + 30])
    best = None
    for rec in repo.sites(p, "calls"):
        kind, nm, ln, c, recv = rec
        if kind != "call" or ln != n or c > col:
            continue
        m = re.compile(r"\s*(?:::\s*<[^()]*>)?\s*\(").match(text, c + len(nm))
        b = m and balanced(text, m.end() - 1)
        if b and m.end() - 1 < col < b[0] and (best is None or m.end() > best[0]):
            best = (m.end(), rec, sum(1 for k in b[1] if k < col))
    if best is None:
        return []
    _, (_, nm, _, _, recv), idx = best
    path = recv and recv[0] == "PATH" and type_head(recv[1])
    out = []
    for g, x in repo.by_name.get(nm, []):
        if x[2] != "fn" or not g.endswith(".rs"):
            continue
        own = repo.owner_type(repo.owners(g, x))
        if (recv is None and own) or (path and path[:1].isupper() and own != path):
            continue
        params = rust_params(repo, g, x)
        # a method called on a receiver takes the receiver as its self, outside the parentheses
        if recv and not path:
            params = [q for q in params if not q[1]]
        if idx < len(params) and params[idx][0]:
            out.append((g, x, params[idx][0]))
    return out


def spawn_sites(repo):
    """The places that start the program they run in again: [(path, line, how)]. In Rust a Command::new of
    std::env::current_exe(), directly or through let bindings and the parameters it is passed as; in Java a
    ProcessBuilder or Runtime.exec in a method that reads the running JVM's command or class path."""
    if hasattr(repo, "_spawns"):
        return repo._spawns
    out = []

    def code(p, n, col):
        return repo.span_at(p, n, col) not in ("comments", "strings")

    def follow(p, fn, start, pat, how, hops):
        ls = lines(p)
        for n in range(start, fn[1] + 1):
            for m in re.finditer(pat, ls[n - 1]):
                if not code(p, n, m.start()):
                    continue
                text = ls[n - 1]
                if re.search(r"\bCommand::new\s*\(", text[:m.start()]):
                    out.append((p, n, how))
                    continue
                bound = re.match(r"\s*let\s+(?:mut\s+)?(\w+)\b[^=]*=(?!=)", text)
                if hops >= 4:
                    continue
                if bound and bound.end() <= m.start():
                    follow(p, fn, n + 1, r"\b%s\b" % bound.group(1), how + " in " + bound.group(1), hops + 1)
                    continue
                for g, x, param in argument_of(repo, p, n, m.start()):
                    follow(g, x, x[0], r"\b%s\b" % param, "%s passed to %s(%s)" % (how, repo.label(g, repo.chain(g, x[0])), param), hops + 1)

    for p, n, text in rg_rows(r"\bcurrent_exe\s*\(", ["-t", "rust"]):
        ch = repo.chain(p, n)
        fn = next((x for x in reversed(ch) if x[2] == "fn"), None)
        if fn and not repo.is_test(p, ch):
            follow(p, fn, n, r"\bcurrent_exe\s*\(", "current_exe()", 0)
    for p, n, text in rg_rows(r"new\s+ProcessBuilder\b|Runtime\.getRuntime\(\)\.exec\s*\(", ["-t", "java"]):
        ch = repo.chain(p, n)
        fn = next((x for x in reversed(ch) if x[2] == "fn"), None)
        m = re.search(r"ProcessBuilder|exec", text)
        if fn and not repo.is_test(p, ch) and code(p, n, m.start()):
            body = "\n".join(lines(p)[fn[0] - 1:fn[1]])
            mark = re.search(r'ProcessHandle\.current\(\)|"java\.class\.path"|"sun\.java\.command"', body)
            if mark:
                out.append((p, n, "this JVM's " + mark.group(0).strip('"')))
    out = [s for s in dict.fromkeys(out) if s[0] and not repo.is_test(s[0], repo.chain(s[0], s[1]))]
    repo._spawns = out
    return out


def spawns_into(repo, f, d):
    """The spawn sites that start the program whose main is D in F: those built into the same program; in Java,
    when the spawning method names classes declaring a main, only theirs."""
    mains = [(g, x) for g, x in repo.by_name.get("main", []) if is_main(repo, g, x) and not repo.is_test(g, repo.chain(g, x[0]))]
    out = []
    for p, n, how in spawn_sites(repo):
        if program_root(p) != program_root(f):
            continue
        if p.endswith(".java"):
            fn = next(x for x in reversed(repo.chain(p, n)) if x[2] == "fn")
            body = "\n".join(lines(p)[fn[0] - 1:fn[1]])
            named = [(g, x) for g, x in mains if g.endswith(".java")
                     and re.search(r"\b%s\b" % re.escape(repo.owner_type(repo.owners(g, x)) or "main"), body)]
            if named and (f, d) not in named:
                continue
        out.append((p, n, how))
    return out


class Out:
    def __init__(self, budget):
        self.rows, self.budget, self.used, self.dropped = [], budget, 0, 0

    def add(self, depth, kind, f, n, text, extra=""):
        self.rows.append((depth, kind, f, n, text, extra))
        self.est = getattr(self, "est", 0) + 2 * depth + len(kind) + min(len(text), 140) + len(extra) + 40

    def full(self):
        return getattr(self, "est", 0) > self.budget

    def render(self, title):
        fs = [r[2] for r in self.rows if r[2]]
        root = os.path.commonpath(fs) if len(set(fs)) > 1 else ""
        root = root if root.count("/") >= 1 else ""
        print(title + ("   root=" + root + "/" if root else ""))
        for depth, kind, f, n, text, extra in self.rows:
            loc = (os.path.relpath(f, root) if root else f) + ":%d" % n if f else ""
            line = "%s%s %s  %s%s" % ("  " * depth, kind, loc, text[:140], extra)
            if self.used + len(line) > self.budget:
                self.dropped += 1
                continue
            self.used += len(line) + 1
            print(line)
        if self.dropped:
            print("... %d more lines over the budget of %d chars; raise --budget or narrow the target" % (self.dropped, self.budget))


def repo_root():
    r = sh(["git", "rev-parse", "--show-toplevel"])
    return r.stdout.decode().strip() if r.returncode == 0 else os.getcwd()


def refuse(msg, as_json):
    """Report a target that names no single definition; as JSON it is an error document and a failing exit."""
    if as_json:
        print(json.dumps({"error": msg}))
        sys.exit(1)
    print(msg)


def cmd_callers(repo, target, depth, budget, include_tests, as_json=False):
    targets = find_targets(repo, target)
    fns = [t for t in targets if t[1][2] == "fn"]
    if not fns:
        types_ = [t for t in targets if t[1][2] in ("type",)]
        if not types_:
            return refuse("no definition named %s; nearest: %s" % (target, ", ".join(sorted(n for n in repo.by_name if target.split('.')[-1].split('::')[-1].lower() in n.lower())[:12])), as_json)
        fns = types_
    out = Out(float("inf") if as_json else budget)
    seen = set()
    owners = Counter(t[2] for t in fns)
    if len(fns) > 1 and len(owners) > 1:
        return refuse("%s names %d definitions; qualify one: %s" % (target, len(fns), ", ".join("%s.%s (%s:%d)" % (o, d[3], f, d[0]) for f, d, o in fns[:12])), as_json)
    root = repo_root()
    rel = lambda p: os.path.relpath(os.path.abspath(p), root)
    doc = {"target": None, "edges": [], "set_aside": [], "entries": [],
           "skipped": [{"file": rel(f), "reason": r} for f, r in sorted(repo.skipped.items())]}

    def place(f, d):
        return {"name": repo.label(f, repo.chain(f, d[0])), "file": rel(f), "line": d[0]}

    def edge(level, kind, p, n, ch, into, test, text, tag):
        doc["edges"].append({"depth": level + 1, "kind": kind, "file": rel(p), "line": n, "fn": repo.label(p, ch) if ch else None,
                             "into": into, "test": test, "text": text, "tag": tag})

    def walk(f, d, own, level, limit):
        key = (f, d[0])
        if key in seen:
            out.add(level, "(seen above)", None, 0, repo.label(f, repo.chain(f, d[0])))
            return
        seen.add(key)
        into = place(f, d)
        if d[2] != "fn":
            own = d[3]
        kept, aside = callers_once(repo, f, d, own, include_tests) if d[2] == "fn" else ([], Counter())
        nxt = []
        # test sites are listed and counted, and climbed only with --tests
        for p, n, text, ch, v, via, test, tag in kept:
            if test and not include_tests:
                edge(level, "call" if v in ("yes", "dyn") else "call?", p, n, ch, into, True, text, tag)
        kept = [k for k in kept if include_tests or not k[6]]
        sure = [k for k in kept if k[4] in ("yes", "dyn")]
        unsure = [k for k in kept if k[4] == "maybe"]
        if len(unsure) > 5 or (sure and unsure):
            aside["unresolved receivers (%s)" % ", ".join(sorted({"%s:%d" % (os.path.basename(k[0]), k[1]) for k in unsure})[:6])] += len(unsure)
            kept = [k for k in kept if k[4] != "maybe"]
        # a guessed receiver is uncertain but climbed, so that a same-named type does not cut the chain
        for p, n, text, ch, v, via, test, tag in kept:
            lab = repo.label(p, ch)
            out.add(level, "call <-" if v in ("yes", "dyn") else "call? <-", p, n, lab + "  | " + text, via)
            edge(level, "call" if v in ("yes", "dyn") else "call?", p, n, ch, into, test, text, tag)
            fn = next((x for x in reversed(ch) if x[2] == "fn"), None)
            if fn and v != "maybe":
                nxt.append((p, fn, repo.owner_type(ch)))
        if aside:
            out.add(level, "set aside:", None, 0, ", ".join("%d %s" % (c, k) for k, c in aside.most_common(6)))
            doc["set_aside"].append({"depth": level + 1, "into": into, "counts": dict(aside)})
        if not sure:
            links = []
            for kind, p, n, text, ch in link_sites(repo, f, d, own):
                if p and not include_tests and repo.is_test(p, ch):
                    head, _, rest = kind.partition(" ")
                    edge(level, head, p, n, ch, into, True, text, rest or ("constructs " + own if head == "new" else None))
                else:
                    links.append((kind, p, n, text, ch))
            if not links and d[2] == "fn":
                out.add(level, "entry:", None, 0, "no caller and no link found for " + repo.label(f, repo.chain(f, d[0])))
                doc["entries"].append({"depth": level + 1, "kind": "none", "into": into, "text": "no caller and no link found"})
            for kind, p, n, text, ch in links[:25]:
                if p is None:
                    out.add(level, kind + ":", None, 0, text)
                    doc["entries"].append({"depth": level + 1, "kind": kind, "into": into, "text": text})
                    continue
                lab = repo.label(p, ch) if ch else ""
                out.add(level, kind + " <-", p, n, (lab + "  | " if lab else "") + text)
                head, _, rest = kind.partition(" ")
                edge(level, head, p, n, ch, into, repo.is_test(p, ch), text, rest or ("constructs " + own if head == "new" else None))
                fn = next((x for x in reversed(ch) if x[2] == "fn"), None)
                if fn and kind != "config":
                    nxt.append((p, fn, repo.owner_type(ch)))
        # a program's main is also reached by the places that start the program again; each is a path of its own,
        # climbed --depth levels from here
        spawned = []
        if is_main(repo, f, d):
            for p, n, how in spawns_into(repo, f, d):
                ch, text = repo.chain(p, n), lines(p)[n - 1].strip()
                out.add(level, "spawn <-", p, n, repo.label(p, ch) + "  | " + text, " [starts this program: %s]" % how)
                edge(level, "spawn", p, n, ch, into, False, text, "starts this program: " + how)
                spawned.append((p, next(x for x in reversed(ch) if x[2] == "fn"), repo.owner_type(ch)))
        expand(nxt, level, limit)
        expand(spawned, level, level + depth)

    def expand(nxt, level, limit):
        if level + 1 < limit and out.full() and nxt:
            out.add(level + 1, "(not expanded, budget reached: %s)" % ", ".join(sorted({repo.label(p, repo.chain(p, fn[0])) for p, fn, o in nxt})[:8]), None, 0, "")
        elif level + 1 < limit:
            done = set()
            for p, fn, o in nxt:
                if (p, fn[0]) in done:
                    continue
                done.add((p, fn[0]))
                out.add(level + 1, "into", p, fn[0], repo.label(p, repo.chain(p, fn[0])) + ":")
                walk(p, fn, o, level + 1, limit)

    firsts = {}
    for f, d, own in fns:
        firsts.setdefault((f, own, d[3]), []).append(d)
    for (f, own, _), ds in firsts.items():
        d = ds[0]
        if len(ds) > 1:
            out.add(0, "(%d overloads at lines %s, traced as one)" % (len(ds), ",".join(str(x[0]) for x in ds)), None, 0, "")
        out.add(0, "target", f, d[0], "%s  %d-%d  %s" % (repo.label(f, repo.chain(f, d[0])), d[0], d[1], d[5][:100]))
        doc["target"] = doc["target"] or place(f, d)
        walk(f, d, own, 0, depth)
    if as_json:
        print(json.dumps(doc))
    else:
        out.render("callers of %s, depth %d" % (target, depth))


def cmd_flow(repo, target, depth, budget, include_tests):
    targets = [t for t in find_targets(repo, target) if t[1][2] == "fn"]
    if not targets:
        print("no function named " + target)
        return
    out, seen = Out(budget), set()

    def walk(f, d, own, level):
        if (f, d[0]) in seen:
            return
        seen.add((f, d[0]))
        lang, ls = lang_of(f), lines(f)
        out.add(level, "def", f, d[0], "%s  %d-%d  %s" % (repo.label(f, repo.chain(f, d[0])), d[0], d[1], d[5][:110]))
        calls = defaultdict(list)
        for rec in repo.sites(f, "calls"):
            if rec[0] == "call" and d[0] < rec[2] <= d[1]:
                calls[rec[2]].append(rec)
        nxt, shown = [], 0
        whole = d[1] - d[0] <= 25
        for n in range(d[0] + 1, d[1] + 1):
            text = ls[n - 1]
            if text.strip() and repo.span_at(f, n, len(text) - len(text.lstrip())) == "comments":
                continue
            marks, hit = [], False
            for rec in sorted(calls.get(n, ()), key=lambda r: r[3]):
                nm = rec[1]
                cands = [c for c in repo.by_name.get(nm, []) if c[1][2] == "fn" and lang_of(c[0]) == lang]
                if not cands:
                    continue
                types, how, _ = receiver(repo, f, rec, lang)
                good = []
                for cf, cd in cands:
                    cown = repo.owner_type(repo.owners(cf, cd))
                    v = verdict(repo, cown, cf, types, how, lang, nm)
                    if v in ("yes", "dyn"):
                        good.append((cf, cd, cown))
                if good:
                    hit = True
                    if len(good) == 1:
                        cf, cd, cown = good[0]
                        marks.append("-> %s %s:%d" % (repo.label(cf, repo.chain(cf, cd[0])), os.path.basename(cf), cd[0]))
                        nxt.append(good[0])
                    else:
                        marks.append("-> %s x%d impls" % (nm, len(good)))
            h = next((m for m in HANDOFF.finditer(text) if repo.span_at(f, n, m.start()) not in ("comments", "strings")), None)
            if h:
                marks.append("[hand-off: %s]" % h.group(0).strip(".(: "))
            if hit or h or (whole and text.strip() not in ("", "{", "}")):
                out.add(level + 1, ":%d" % n, None, 0, text.strip(), ("   " + " ".join(marks)) if marks else "")
                shown += 1
        out.add(level + 1, "(%d of %d lines shown)" % (shown, d[1] - d[0]), None, 0, "")
        if level + 1 < depth:
            for cf, cd, cown in nxt:
                if cd[1] - cd[0] >= 3 and not out.full() and not (repo.is_test(cf, repo.chain(cf, cd[0])) and not include_tests):
                    walk(cf, cd, cown, level + 1)

    for f, d, own in targets[:3]:
        walk(f, d, own, 0)
    out.render("flow of %s, depth %d" % (target, depth))


def cmd_refs(repo, pattern, budget, include_tests):
    rows = rg_rows(pattern, ["-g", "!*.{class,jar,map,log,rpc}", "--max-filesize", "1M"])
    out, aside, groups = Out(budget), Counter(), defaultdict(list)
    for p, n, text in rows:
        ch = repo.chain(p, n) if lang_of(p) else []
        m = re.search(pattern, text)
        col = m.start() if m else 0
        if lang_of(p):
            if repo.is_test(p, ch) and not include_tests:
                aside["in tests (%s)" % os.path.basename(p)] += 1
                continue
            span = repo.span_at(p, n, col)
            if span in ("comments", "imports"):
                aside[span] += 1
                continue
        groups[(p, repo.label(p, ch) if ch else "")].append((n, text.strip()))
    for (p, lab), ms in groups.items():
        for n, text in ms[:4]:
            out.add(0, "", p, n, (lab + "  | " if lab else "") + text)
        if len(ms) > 4:
            out.add(1, "+%d more in %s at lines %s" % (len(ms) - 4, lab, ",".join(str(n) for n, _ in ms[4:16])), None, 0, "")
    if aside:
        out.add(0, "set aside:", None, 0, ", ".join("%d %s" % (c, k) for k, c in aside.most_common(8)))
    out.render("%d matches of %s in %d files" % (len(rows), pattern, len({r[0] for r in rows})))


def report_skipped(repo):
    if repo.skipped:
        print("ast-grep skipped %d files, so their definitions and call sites are missing: %s" % (
            len(repo.skipped), ", ".join("%s (%s)" % (f, r) for f, r in sorted(repo.skipped.items())[:12])))


def main():
    a = sys.argv[1:]
    def opt(name, default, cast=int):
        if name in a:
            i = a.index(name)
            v = cast(a[i + 1])
            del a[i:i + 2]
            return v
        return default
    depth, budget = opt("--depth", 3), opt("--budget", 6000)
    tests, as_json = "--tests" in a, "--json" in a
    a = [x for x in a if x not in ("--tests", "--json")]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    if as_json and a[0] != "callers":
        sys.exit("--json is implemented for callers only")
    repo = Repo()
    if a[0] == "index":
        print(json.dumps(dict(repo.stats, defs=sum(len(r["defs"]) for r in repo.idx.values()), types=len(repo.types),
                              **({"skipped": repo.skipped} if repo.skipped else {}))))
        return
    if a[0] == "callers":
        cmd_callers(repo, a[1], depth, budget, tests, as_json)
        if as_json:
            return
    elif a[0] == "flow":
        cmd_flow(repo, a[1], depth, budget, tests)
    elif a[0] == "refs":
        cmd_refs(repo, a[1], budget, tests)
    elif a[0] == "precision":
        # ambiguous method names: raw word matches against the call sites attributed to one definition
        import random
        random.seed(7)
        lang = a[1]
        cands = []
        for name, ds in repo.by_name.items():
            owners = {repo.owner_type(repo.owners(f, d)) for f, d in ds if d[2] == "fn" and lang_of(f) == lang and not repo.is_test(f, repo.chain(f, d[0]))}
            owners.discard(None)
            if len(owners) >= 3 and len(name) > 3:
                cands.append(name)
        random.shuffle(cands)
        tot = Counter()
        rows_out = []
        for name in cands[:int(a[2])]:
            f, d = next((f, d) for f, d in repo.by_name[name] if d[2] == "fn" and lang_of(f) == lang and not repo.is_test(f, repo.chain(f, d[0])) and repo.owner_type(repo.owners(f, d)))
            own = repo.owner_type(repo.owners(f, d))
            kept, aside = callers_once(repo, f, d, own, True)
            raw = len(kept) + sum(aside.values())
            yes = sum(1 for k in kept if k[4] in ("yes", "dyn"))
            maybe = len(kept) - yes
            other = sum(c for k, c in aside.items() if k.startswith("other receiver"))
            tot.update(raw=raw, yes=yes, maybe=maybe, other=other, names=1)
            rows_out.append("%s.%s raw=%d yes=%d maybe=%d other_receiver=%d" % (own, name, raw, yes, maybe, other))
        print(json.dumps(tot))
        print("\n".join(rows_out[:40]))
    elif a[0] == "skeleton":
        # how much of a long function the flow digest keeps
        lang, tot = a[1], Counter()
        for f, rec in repo.idx.items():
            if lang_of(f) != lang:
                continue
            for d in rec["defs"]:
                if d[2] == "fn" and d[1] - d[0] >= 40 and not repo.is_test(f, repo.chain(f, d[0])):
                    tot["fns"] += 1
                    tot["lines"] += d[1] - d[0] + 1
                    tot["chars"] += sum(len(x) + 8 for x in lines(f)[d[0] - 1:d[1]])
                    tot["kept_fns"] += 1
        print(json.dumps(tot))
        return
    report_skipped(repo)


main()
